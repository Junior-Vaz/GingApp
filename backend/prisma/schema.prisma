// GingApp — schema Prisma
// Modelado a partir de PLANO_PROJETO.md, secao 2 (Banco de Dados).
// Estrategia de multi-tenancy: isolamento em camada de aplicacao (nao ha RLS no Postgres).
// Toda entidade "privada" de um grupo carrega organizationId e todo service DEVE filtrar por ele.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserType {
  MEMBER
  PLATFORM
}

/// Papel do usuario dentro de uma organizacao especifica (vive em OrganizationUser,
/// nao em User, porque a mesma pessoa pode ter papeis diferentes em grupos diferentes).
enum OrgRole {
  MESTRE
  PROFESSOR
  ALUNO
  RESPONSAVEL
}

/// Tipo de organizacao. SYSTEM e reservado para a organizacao "fantasma" (id fixo) usada
/// apenas por seed/health-check de contas PLATFORM, que nao pertencem a nenhum grupo real
/// (PLANO_PROJETO.md §2.2). GROUP e um grupo de capoeira real (tenant).
enum OrganizationType {
  SYSTEM
  GROUP
}

/// Status generico para entidades de organizacao sem regra de negocio propria de status
/// (decisao de modelagem: o plano so especifica literalmente `status String @default("ACTIVE")`
/// para User e OrganizationUser; para as demais entidades foi adotado este enum para dar
/// type-safety sem inventar estados que o plano nao pediu).
enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  FORMER
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Forma de pagamento da baixa de um lançamento (E07).
enum PaymentMethod {
  CASH
  PIX
  CARD
  TRANSFER
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  CANCELLED
  /// Lista de espera de evento lotado (Event.capacity): nao ocupa vaga; o primeiro da fila (menor id) e promovido a
  /// CONFIRMED quando uma vaga abre.
  WAITLIST
}

/// Situacao de publicacao do evento: DRAFT (so a equipe ve), PUBLISHED (aberto), CANCELLED (cancelado: inscritos
/// notificados, sem novas inscricoes), CLOSED (encerrado: sem novas inscricoes).
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  CLOSED
}

/// Recorrencia de uma roda (so a roda "mae" tem; as ocorrencias geradas ficam NONE + parentRodaId):
/// WEEKLY = todo mesmo dia da semana; MONTHLY_WEEKDAY = "toda 1a sexta" (n-esimo dia da semana do mes, derivado de
/// Roda.date); MONTHLY_DAY = "todo dia X" (dia do mes de Roda.date, limitado ao ultimo dia dos meses curtos).
enum RodaRecurrence {
  NONE
  WEEKLY
  MONTHLY_WEEKDAY
  MONTHLY_DAY
}

// =========================================================================
// PLATAFORMA (GestorPrint-style)
// =========================================================================

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  passwordHash            String
  name                    String
  phone                   String?
  photo                   String?
  userType                UserType  @default(MEMBER)
  isSuperAdmin            Boolean   @default(false)
  status                  String    @default("ACTIVE")
  /// 2FA TOTP (RFC 6238), opt-in. O segredo fica CIFRADO em repouso (AES-256-GCM, ver
  /// shared/security/two-factor-crypto.ts) e nunca e' devolvido depois do setup. Enquanto
  /// twoFactorEnabled=false o segredo e' so' um setup pendente (ainda nao confirmado com um codigo).
  twoFactorSecret         String?
  twoFactorEnabled        Boolean   @default(false)
  /// Hashes (HMAC-SHA256) dos codigos de recuperacao ainda NAO usados; cada um vale uma unica vez.
  twoFactorRecoveryHashes String[]  @default([])
  /// Ultimo passo de 30 s de TOTP aceito (anti-replay: o mesmo codigo nao vale duas vezes).
  twoFactorLastStep       Int?
  tokenValidAfter         DateTime?
  /// true quando a senha atual foi definida por outra pessoa (conta de aluno/responsavel criada pelo
  /// Mestre/Professor, ou senha redefinida por ele): os frontends devem exigir a troca no proximo login.
  /// Limpo por POST /auth/change-password.
  mustChangePassword      Boolean   @default(false)
  /// Aceite dos Termos de Uso + Politica de Privacidade (LGPD, E10): versao do texto aceita pelo titular
  /// (ver backend/src/shared/legal) e quando. NULL = nunca aceitou. Um texto novo (versao diferente da
  /// atual) volta a exigir o aceite. O servidor so BLOQUEIA o uso se TERMS_ENFORCEMENT=true; por padrao
  /// quem barra e o frontend (modal bloqueante), para nao quebrar seed/demo/e2e.
  acceptedTermsVersion    String?
  acceptedTermsAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  memberships                  OrganizationUser[]
  unitAccess                   UserUnitAccess[]
  auditLogs                    AuditLog[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  pushPreference               PushPreference?
  createdAnnouncements         Announcement[]         @relation("AnnouncementCreatedBy")
  createdPlatformAnnouncements PlatformAnnouncement[] @relation("PlatformAnnouncementCreatedBy")
  studentLinks                 Student[]              @relation("StudentUser")
  guardianLinks                StudentGuardian[]      @relation("StudentGuardianUser")
  taughtLessons                Lesson[]               @relation("LessonTeacher")
  taughtClasses                Class[]                @relation("ClassTeacher")
  eventParticipations          EventParticipant[]     @relation("EventParticipantUser")
  rodaParticipations           RodaParticipant[]      @relation("RodaParticipantUser")
  publicProfile                PublicProfile?         @relation("PublicProfileUser")
  updatedPlatformSettings      PlatformSetting[]      @relation("PlatformSettingUpdatedBy")
  dataDeletionRequests         DataDeletionRequest[]  @relation("DataDeletionRequestUser")
  passwordResetTokens          PasswordResetToken[]   @relation("PasswordResetTokenUser")
  uploads                      Upload[]               @relation("UploadUser")

  @@index([userType])
}

/// Token de uso unico para definir/redefinir a senha por e-mail (E05): "esqueci a senha" (purpose RESET, 1 h)
/// e convite de aluno/responsavel (purpose INVITE, 72 h). O token em claro so existe no link enviado por
/// e-mail; aqui fica apenas o SHA-256 (tokenHash). Um pedido novo invalida os anteriores (usedAt).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  /// RESET | INVITE
  purpose   String    @default("RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("PasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Pedido do titular para excluir/anonimizar os proprios dados (LGPD art. 18, E10). POST /auth/me/delete-request
/// apenas REGISTRA o pedido (status PENDING): nada e apagado automaticamente — a equipe/Mestre avalia (ha
/// historico escolar/financeiro a preservar) e executa manualmente, depois marca RESOLVED/REJECTED.
model DataDeletionRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  /// Grupo do token no momento do pedido (NULL para equipe PLATFORM).
  organizationId Int?
  /// PENDING | IN_PROGRESS | DONE | REJECTED (texto livre de proposito, como Notification.type).
  status         String    @default("PENDING")
  reason         String?
  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  user User @relation("DataDeletionRequestUser", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, requestedAt])
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String
  code          String   @unique
  priceCents    Int      @default(0)
  billingPeriod String   @default("MONTHLY")
  maxUnits      Int?
  maxStudents   Int?
  features      Json     @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

/// gatewayProvider/gatewayCustomerId/gatewaySubscriptionId: referencia do gateway de pagamento
/// externo (Fase 2, PLANO_PROJETO.md §10.13). "stub" por enquanto (BillingGatewayService
/// simulado, sem credenciais reais de nenhum gateway) — trocar por "asaas"/"stripe"/etc quando
/// houver credenciais de verdade, sem precisar de migration nova (os campos já existem).
model Subscription {
  id                    Int                @id @default(autoincrement())
  organizationId        Int
  planId                Int
  status                SubscriptionStatus @default(TRIALING)
  gatewayProvider       String             @default("stub")
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  startedAt             DateTime           @default(now())
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  plan         Plan                @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]

  @@index([organizationId, status])
}

model SubscriptionEvent {
  id             Int      @id @default(autoincrement())
  subscriptionId Int
  type           String
  payload        Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, createdAt])
}

model OrganizationFeatureOverride {
  id             Int      @id @default(autoincrement())
  organizationId Int
  featureKey     String
  enabled        Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureKey])
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  role      OrgRole
  resource  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, resource])
}

model PlatformSetting {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           Json
  isSecret        Boolean  @default(false)
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  updatedByUser User? @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id])
}

model PlatformAnnouncement {
  id                   Int       @id @default(autoincrement())
  title                String
  body                 String
  targetOrganizationId Int?
  publishedAt          DateTime?
  expiresAt            DateTime?
  isActive             Boolean   @default(true)
  createdByUserId      Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdByUser      User          @relation("PlatformAnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  targetOrganization Organization? @relation(fields: [targetOrganizationId], references: [id])

  @@index([isActive, publishedAt])
}

/// Trilha de auditoria unica (plataforma + grupo). organizationId nulo = acao de escopo
/// de plataforma (ex.: platform-login, alteracao de plano).
model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// =========================================================================
// ORGANIZACAO (dominio do projeto.txt)
// =========================================================================

model Organization {
  id                  Int              @id @default(autoincrement())
  name                String
  slug                String           @unique
  type                OrganizationType @default(GROUP)
  status              RecordStatus     @default(ACTIVE)
  document            String?
  email               String?
  phone               String?
  logo                String?
  /// Perfil institucional do grupo (projeto.txt §13), editado pelo MESTRE em PATCH /organizations/me.
  /// description = apresentacao curta; history = historia do grupo; foundedYear = ano de fundacao;
  /// city/state = cidade e UF-sede (texto livre, nao FK); website = site; socialLinks = redes
  /// ({ instagram?, youtube?, tiktok?, facebook?, whatsapp? }, todas opcionais, so URLs).
  description         String?
  history             String?
  foundedYear         Int?
  city                String?
  state               String?
  website             String?
  socialLinks         Json?
  /// "Como pagar" (E07): texto livre (chave PIX, dados bancarios, link, orientacoes) mostrado ao aluno/
  /// responsavel no app. Editado pelo MESTRE em PATCH /organizations/me.
  paymentInstructions String?
  /// Mapa da comunidade (GET /map/places): o MESTRE controla se o grupo (unidades, treinos, eventos publicos e
  /// rodas organizadas por ele) aparece no mapa. Padrao true; grupo INACTIVE nunca aparece, qualquer que seja o valor.
  mapVisible          Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  studentBillings       StudentBilling[]
  users                 OrganizationUser[]
  units                 Unit[]
  userUnitAccess        UserUnitAccess[]
  students              Student[]
  studentGuardians      StudentGuardian[]
  classes               Class[]
  classStudents         ClassStudent[]
  lessons               Lesson[]
  attendances           Attendance[]
  graduationSystems     GraduationSystem[]
  graduationLevels      GraduationLevel[]
  studentGraduations    StudentGraduation[]
  financialRecords      FinancialRecord[]
  events                Event[]
  eventParticipants     EventParticipant[]
  announcements         Announcement[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  subscriptions         Subscription[]
  featureOverrides      OrganizationFeatureOverride[]
  auditLogs             AuditLog[]
  platformAnnouncements PlatformAnnouncement[]
  publicProfiles        PublicProfile[]
  certificates          Certificate[]
  rodas                 Roda[]
  uploads               Upload[]
  pointEvents           PointEvent[]

  @@index([status])
}

/// Imagem enviada por POST /uploads (foto de aluno, logo do grupo, capa de evento/roda, perfil no app).
/// O arquivo fica em disco (UPLOADS_DIR, volume Docker gingapp_uploads) com nome aleatorio (uuid) em
/// `filename`; esta linha guarda a que grupo/usuario ele pertence e o tamanho (cota por grupo).
model Upload {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  /// Nome do arquivo em disco (uuid + extensao): o mesmo que aparece na URL /api/uploads/<filename>.
  filename       String   @unique
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("UploadUser", fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

model OrganizationUser {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           OrgRole
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

model Unit {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  address        String?
  city           String?
  state          String?
  /// Coordenadas para o mapa da comunidade (opcionais): informadas pelo usuario ou geocodificadas
  /// (shared/geo/geocoding.service.ts) a partir de address/city/state quando ha chave do Google.
  latitude       Float?
  longitude      Float?
  /// Foto da unidade (URL http(s) ou /api/uploads/<uuid>.<ext>, validada por IsImageRef). Aparece nas turmas/aulas e no mapa.
  photo          String?
  isMain         Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  userAccess       UserUnitAccess[]
  students         Student[]
  classes          Class[]
  lessons          Lesson[]
  financialRecords FinancialRecord[]
  events           Event[]
  announcements    Announcement[]

  @@index([organizationId, status])
  @@index([latitude, longitude])
}

/// Professor autorizado em multiplas unidades (matriz/filial) dentro de uma mesma
/// organizacao — PLANO_PROJETO.md §3.2 item 5.
model UserUnitAccess {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  unitId         Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId])
  @@index([organizationId])
}

model Student {
  id             Int           @id @default(autoincrement())
  organizationId Int
  unitId         Int?
  /// Um User pode ser aluno em VARIOS grupos (um Student por organizacao): unicidade so por (organizationId, userId).
  /// NULLs repetidos sao permitidos (aluno sem login).
  userId         Int?
  name           String
  birthDate      DateTime?
  document       String?
  phone          String?
  email          String?
  photo          String?
  /// URL de uma foto de capa/fundo pro cartão de perfil no PWA (mesmo padrão leve de photo
  /// acima — só URL, sem upload). Auto-atendimento: o próprio aluno/responsável define a sua
  /// via PATCH /students/me/profile — não é um campo gerenciado pelo painel/admin.
  coverPhoto     String?
  /// Links de redes sociais do praticante ({ instagram?, youtube?, tiktok?, facebook?,
  /// whatsapp? }, todos opcionais) — mesmo raciocínio de auto-atendimento do coverPhoto acima.
  socialLinks    Json?
  status         StudentStatus @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id])
  unit                Unit?               @relation(fields: [unitId], references: [id])
  user                User?               @relation("StudentUser", fields: [userId], references: [id])
  guardians           StudentGuardian[]
  classStudents       ClassStudent[]
  attendances         Attendance[]
  graduations         StudentGraduation[]
  financialRecords    FinancialRecord[]
  eventParticipations EventParticipant[]
  rodaParticipations  RodaParticipant[]
  publicProfile       PublicProfile?      @relation("PublicProfileStudent")
  certificates        Certificate[]
  billing             StudentBilling?
  pointEvents         PointEvent[]
  rankingProfile      RankingProfile?
  achievements        Achievement[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
}

/// Cobranca mensal do aluno (E07): valor da mensalidade (centavos) e dia de vencimento (1..31; em meses
/// curtos vale o ultimo dia do mes). Tabela PROPRIA (nao colunas de Student) de proposito: o financeiro e
/// so do MESTRE, e GET /students e lido por professor — o valor nao pode vazar por la.
model StudentBilling {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  studentId       Int      @unique
  monthlyFeeCents Int
  dueDay          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Responsavel legal do aluno (obrigatorio quando o aluno e menor de idade, por birthDate —
/// PLANO_PROJETO.md §3.4). userId e opcional: um responsavel pode ou nao ter login proprio
/// no app.gingapp.com.br (decisao de modelagem, plano nao detalha o formato exato).
model StudentGuardian {
  id                   Int      @id @default(autoincrement())
  organizationId       Int
  studentId            Int
  userId               Int?
  name                 String
  relationship         String?
  phone                String?
  email                String?
  consentPublicProfile Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  user           User?           @relation("StudentGuardianUser", fields: [userId], references: [id])
  publicProfiles PublicProfile[] @relation("PublicProfileGuardianConsent")

  @@index([organizationId])
  @@index([studentId])
}

model Class {
  id             Int          @id @default(autoincrement())
  organizationId Int
  unitId         Int?
  name           String
  description    String?
  weekday        Int?
  startTime      String?
  endTime        String?
  /// Professor responsavel pela turma: User.id de um membro ATIVO MESTRE/PROFESSOR do mesmo
  /// grupo (validado no service, mesmo padrao de Lesson.teacherUserId). Copiado para as aulas
  /// geradas por POST /classes/:id/generate-lessons.
  teacherUserId  Int?
  /// Foto da turma (URL http(s) ou /api/uploads/<uuid>.<ext>, validada por IsImageRef).
  photo          String?
  /// Aulas continuas (sem data final): true = o job diario (e o ensureHorizon ao criar/editar a turma) mantem as
  /// aulas geradas ate LESSONS_HORIZON_DAYS a frente, a partir do weekday/horario da turma. Turmas ja existentes
  /// migram com true (passam a ter aulas geradas automaticamente); false = so geracao manual por periodo.
  autoGenerateLessons Boolean  @default(true)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])
  teacher       User?          @relation("ClassTeacher", fields: [teacherUserId], references: [id])
  classStudents ClassStudent[]
  lessons       Lesson[]
  announcements Announcement[]

  @@index([organizationId, status])
  @@index([teacherUserId])
}

model ClassStudent {
  id             Int          @id @default(autoincrement())
  organizationId Int
  classId        Int
  studentId      Int
  status         RecordStatus @default(ACTIVE)
  enrolledAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([organizationId])
}

model Lesson {
  id             Int          @id @default(autoincrement())
  organizationId Int
  classId        Int
  unitId         Int?
  teacherUserId  Int?
  date           DateTime
  startTime      String?
  endTime        String?
  notes          String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  teacher      User?        @relation("LessonTeacher", fields: [teacherUserId], references: [id])
  attendances  Attendance[]

  @@index([organizationId, date])
  @@index([classId, date])
}

model Attendance {
  id             Int      @id @default(autoincrement())
  organizationId Int
  lessonId       Int
  studentId      Int
  present        Boolean  @default(true)
  justification  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  lesson       Lesson       @relation(fields: [lessonId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId, createdAt])
}

/// Sistema de graduacao configuravel por grupo (PLANO_PROJETO.md §2.3 e projeto.txt §26).
model GraduationSystem {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  levels       GraduationLevel[]

  @@index([organizationId])
}

model GraduationLevel {
  id                 Int      @id @default(autoincrement())
  organizationId     Int
  graduationSystemId Int
  name               String
  order              Int
  color              String?
  createdAt          DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  graduationSystem   GraduationSystem    @relation(fields: [graduationSystemId], references: [id])
  studentGraduations StudentGraduation[]

  @@unique([graduationSystemId, order])
  @@index([organizationId])
}

model StudentGraduation {
  id                Int      @id @default(autoincrement())
  organizationId    Int
  studentId         Int
  graduationLevelId Int
  graduatedAt       DateTime
  notes             String?
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  graduationLevel GraduationLevel @relation(fields: [graduationLevelId], references: [id])
  certificates    Certificate[]

  @@index([studentId, createdAt])
}

/// amountCents: valores monetarios sempre em centavos (Int) para evitar erro de ponto
/// flutuante — decisao de modelagem, o plano nao especifica o tipo do campo.
model FinancialRecord {
  id             Int             @id @default(autoincrement())
  organizationId Int
  studentId      Int?
  unitId         Int?
  description    String
  amountCents    Int
  type           String?
  dueDate        DateTime
  paidAt         DateTime?
  status         FinancialStatus @default(PENDING)
  /// Competencia 'YYYY-MM' (so nos lancamentos gerados em lote por POST /finance/generate-monthly); o
  /// unique (studentId, competence, type) garante 1 mensalidade por aluno+mes mesmo com chamadas
  /// concorrentes (NULLs sao distintos no Postgres: lancamentos avulsos nao sao afetados).
  competence     String?
  /// Baixa (E07): forma de pagamento e valor efetivamente pago (centavos; padrao = amountCents).
  paymentMethod  PaymentMethod?
  paidCents      Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([studentId, competence, type])
  @@index([organizationId, status])
  @@index([studentId, dueDate])
}

/// type: categoria livre (BATIZADO/WORKSHOP/CAMPEONATO/FESTIVAL/ENCONTRO/FORMATURA/VIAGEM/
/// AULA_ESPECIAL/OUTRO, projeto.txt §43 — "RODA" fica de fora, esse tipo já tem o model Roda
/// dedicado). String (não enum) de propósito, mesmo espírito de Notification.type/
/// SubscriptionEvent.type: é uma tag de categorização/filtro, não uma regra de negócio.
///
/// stateId/cityId: mesmos campos que Roda já tinha desde a fundação — permitem o Calendário
/// estadual (projeto.txt §42, Fase 2 §10.17) agregar Roda+Event num só feed público filtrável.
model Event {
  id                   Int         @id @default(autoincrement())
  organizationId       Int
  unitId               Int?
  stateId              Int?
  cityId               Int?
  title                String
  type                 String      @default("OUTRO")
  description          String?
  date                 DateTime
  location             String?
  /// Coordenadas do local para o mapa da comunidade (opcionais; ver Unit.latitude).
  latitude             Float?
  longitude            Float?
  isPublic             Boolean     @default(false)
  /// URL de uma imagem de capa (sem upload de arquivo — mesmo padrão leve de Student.photo/
  /// PublicProfile.photo). Usada nos cards do feed (Home/Calendário, PLANO_PROJETO.md §10.21/
  /// §10.22); sem ela, o card usa um placeholder ilustrado com o ícone do tipo.
  imageUrl             String?
  /// Vagas (null = ilimitado). Contam CONFIRMED + ATTENDED; acima disso a inscricao vai para a lista de espera
  /// (ParticipantStatus.WAITLIST) so a pedido do inscrito.
  capacity             Int?
  /// Valor de inscricao em centavos (null/0 = gratuito). INFORMATIVO: nao ha cobranca online nesta versao.
  priceCents           Int?
  /// DRAFT/PUBLISHED/CANCELLED/CLOSED (ver enum EventStatus). Eventos antigos nascem PUBLISHED.
  status               EventStatus @default(PUBLISHED)
  /// Prazo das inscricoes feitas pelo proprio aluno/responsavel (a equipe inscreve a qualquer momento).
  registrationDeadline DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  unit         Unit?              @relation(fields: [unitId], references: [id])
  state        State?             @relation(fields: [stateId], references: [id])
  city         City?              @relation(fields: [cityId], references: [id])
  participants EventParticipant[]

  @@index([organizationId, date])
  @@index([stateId, date])
  @@index([cityId, date])
  @@index([latitude, longitude])
}

/// guestName cobre participantes sem cadastro de student/user (ex.: convidado externo em
/// evento aberto) — decisao de modelagem.
model EventParticipant {
  id             Int               @id @default(autoincrement())
  organizationId Int
  eventId        Int
  studentId      Int?
  userId         Int?
  guestName      String?
  status         ParticipantStatus @default(CONFIRMED)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  user         User?        @relation("EventParticipantUser", fields: [userId], references: [id])

  @@index([eventId])
  @@index([organizationId])
}

/// Comunicados internos do grupo, com escopo opcional por unidade (projeto.txt §47).
model Announcement {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  unitId          Int?
  title           String
  body            String
  publishedAt     DateTime?
  isActive        Boolean   @default(true)
  /// Alcance adicional (todos opcionais; se combinam por E): so alunos matriculados (ClassStudent ACTIVE) nesta turma
  /// e seus responsaveis; so quem pertence a unidades da UF (Unit.state); so um papel do grupo (ALUNO, RESPONSAVEL...).
  classId         Int?
  stateUf         String?
  audienceRole    OrgRole?
  createdByUserId Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  unit          Unit?        @relation(fields: [unitId], references: [id])
  class         Class?       @relation(fields: [classId], references: [id])
  createdByUser User         @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId, publishedAt])
}

model Notification {
  id             Int       @id @default(autoincrement())
  organizationId Int?
  userId         Int
  title          String
  body           String
  type           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// Web Push (I13): um dispositivo/navegador inscrito para receber avisos no celular. OPCIONAL: so' usado quando
/// VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT estao configuradas. `endpoint` e' unico no mundo (identifica a
/// inscricao do navegador); reinscrever o mesmo endpoint e' idempotente. Apagada em 404/410 do servico de push.
model PushSubscription {
  id             Int       @id @default(autoincrement())
  userId         Int
  organizationId Int?
  /// Web Push (VAPID): endpoint + chaves. Nulos nas linhas provider='fcm' (so' o token).
  endpoint       String?   @unique
  p256dh         String?
  auth           String?
  /// 'webpush' (VAPID, lib web-push) ou 'fcm' (Firebase Cloud Messaging).
  provider       String    @default("webpush")
  /// FCM registration token (provider='fcm'); unico no sistema.
  token          String?   @unique
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Quais categorias de aviso o usuario quer receber como push (a notificacao in-app e' sempre gravada).
/// Sem linha = tudo ligado.
model PushPreference {
  userId        Int      @id
  lessons       Boolean  @default(true)
  finance       Boolean  @default(true)
  events        Boolean  @default(true)
  graduations   Boolean  @default(true)
  announcements Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================================
// COMUNIDADE (publica / compartilhavel)
// =========================================================================

model State {
  id        Int      @id @default(autoincrement())
  name      String
  uf        String   @unique
  createdAt DateTime @default(now())

  cities      City[]
  communities Community[]
  rodas       Roda[]
  events      Event[]
}

model City {
  id        Int      @id @default(autoincrement())
  stateId   Int
  name      String
  createdAt DateTime @default(now())

  state  State   @relation(fields: [stateId], references: [id])
  rodas  Roda[]
  events Event[]

  @@index([stateId])
}

model Community {
  id          Int      @id @default(autoincrement())
  stateId     Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  state State  @relation(fields: [stateId], references: [id])
  rodas Roda[]

  @@index([stateId])
}

/// organizationId (opcional): identifica qual grupo organiza a roda, para permitir edição/
/// exclusão restrita a quem criou. Nullable porque uma roda pode, no futuro, ser publicada
/// por um perfil independente sem organização — mas hoje toda criação parte de um usuário
/// MEMBER autenticado, então sempre virá preenchido na prática (PLANO_PROJETO.md §10.7,
/// gap identificado: o schema original não tinha essa FK e não dava para restringir quem
/// pode editar/apagar uma roda de outro grupo).
model Roda {
  id              Int            @id @default(autoincrement())
  organizationId  Int?
  communityId     Int?
  stateId         Int?
  cityId          Int?
  title           String
  description     String?
  date            DateTime
  location        String?
  /// Coordenadas do local para o mapa da comunidade (opcionais; ver Unit.latitude).
  latitude        Float?
  longitude       Float?
  /// Mesma convenção de Event.imageUrl acima — URL de capa opcional, sem upload de arquivo.
  imageUrl        String?
  /// Recorrencia ("roda mensal"): a roda MAE guarda a regra (derivada de `date`: dia da semana, n-esimo dia da
  /// semana do mes ou dia do mes) e POST /rodas/:id/generate-occurrences cria as proximas ocorrencias como rodas
  /// filhas (parentRodaId), de forma idempotente. As filhas tem recurrence NONE.
  recurrence      RodaRecurrence @default(NONE)
  /// Ultimo dia (inclusive) em que a serie pode gerar ocorrencias; null = sem fim.
  recurrenceUntil DateTime?
  parentRodaId    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id])
  community    Community?        @relation(fields: [communityId], references: [id])
  state        State?            @relation(fields: [stateId], references: [id])
  city         City?             @relation(fields: [cityId], references: [id])
  parent       Roda?             @relation("RodaOccurrences", fields: [parentRodaId], references: [id], onDelete: SetNull)
  occurrences  Roda[]            @relation("RodaOccurrences")
  participants RodaParticipant[]

  @@unique([parentRodaId, date])
  @@index([organizationId])
  @@index([stateId, date])
  @@index([cityId, date])
  @@index([latitude, longitude])
}

model RodaParticipant {
  id        Int               @id @default(autoincrement())
  rodaId    Int
  userId    Int?
  studentId Int?
  guestName String?
  status    ParticipantStatus @default(CONFIRMED)
  createdAt DateTime          @default(now())

  roda    Roda     @relation(fields: [rodaId], references: [id])
  user    User?    @relation("RodaParticipantUser", fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([rodaId])
}

/// Perfil publico opt-in (projeto.txt §17/§53). Para menores, exige consentByGuardianId
/// preenchido — nunca opt-in automatico (PLANO_PROJETO.md §3.4). Nenhum dado privado
/// (students, financial_records, student_guardians) e exposto aqui alem do essencial.
///
/// publicCode: token publico nao-sequencial (mesmo espirito de Certificate.verificationCode,
/// Fase 2 §10.15) — a URL/QR do Passaporte do Capoeirista aponta pra esse codigo, nunca pro
/// `id` (PLANO_PROJETO.md §10.16).
model PublicProfile {
  id                  Int      @id @default(autoincrement())
  organizationId      Int?
  userId              Int?     @unique
  studentId           Int?     @unique
  displayName         String
  bio                 String?
  photo               String?
  consentByGuardianId Int?
  isPublished         Boolean  @default(false)
  publicCode          String   @unique @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization?    @relation(fields: [organizationId], references: [id])
  user              User?            @relation("PublicProfileUser", fields: [userId], references: [id])
  student           Student?         @relation("PublicProfileStudent", fields: [studentId], references: [id])
  consentByGuardian StudentGuardian? @relation("PublicProfileGuardianConsent", fields: [consentByGuardianId], references: [id])

  @@index([organizationId])
}

/// Modelo simples (Certificate e Fase 2 no roadmap, PLANO_PROJETO.md §7) — presente desde
/// ja no schema apenas para nao exigir migration nova quando a feature for implementada.
/// verificationCode: token público não-sequencial (projeto.txt §52: "QR Code poderá validar a
/// autenticidade") — o QR aponta para uma URL pública com esse código, nunca com o `id`
/// (sequencial, enumerável). Ver Fase 2, PLANO_PROJETO.md §10.15.
model Certificate {
  id                  Int       @id @default(autoincrement())
  organizationId      Int
  studentId           Int
  studentGraduationId Int?
  title               String
  issuedAt            DateTime?
  fileUrl             String?
  verificationCode    String    @unique @default(cuid())
  createdAt           DateTime  @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])
  studentGraduation StudentGraduation? @relation(fields: [studentGraduationId], references: [id])

  @@index([organizationId])
  @@index([studentId])
}

// =========================================================================
// GINGA RANK (ranking de alunos e grupos)
// =========================================================================

/// Tipo de ponto do Ginga Rank. Os valores e as regras ficam em src/interface/http/ranking/ranking-rules.ts (SSOT).
/// Mensalidade/financeiro NUNCA gera ponto.
enum PointEventType {
  CLASS_ATTENDANCE
  STREAK_BONUS
  EVENT_ATTENDANCE
  RODA_PARTICIPATION
  MONTHLY_CONSISTENCY
  GRADUATION
  CERTIFICATE
}

/// Ponto ganho por um aluno, DERIVADO das tabelas de origem (presenca, evento, roda, graduacao, certificado) por
/// RankingService.syncStudent (idempotente: upsert pela chave unica + remocao do que deixou de existir na origem).
/// refType/refId identificam a origem (ex.: 'Lesson'/'123', 'Week'/'2026-10-05', 'Month'/'2026-09'). season = 'YYYY-MM'
/// (mes do ponto; data civil UTC para aula/graduacao, America/Sao_Paulo para instantes).
model PointEvent {
  id             Int            @id @default(autoincrement())
  organizationId Int
  studentId      Int
  type           PointEventType
  points         Int
  refType        String
  refId          String
  occurredAt     DateTime
  season         String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, type, refType, refId])
  @@index([season, organizationId])
  @@index([studentId, season])
}

/// Preferencias do aluno no ranking. Sem linha = opt-in desligado e sem apelido. optInPublic liga a aparicao nos
/// rankings ABERTOS (cidade/estado/Brasil); menor de idade so aparece la com o consentimento do responsavel
/// (StudentGuardian.consentPublicProfile, o MESMO consentimento do Passaporte). No ranking do proprio grupo todos
/// os alunos ATIVOS aparecem sempre.
model RankingProfile {
  id          Int      @id @default(autoincrement())
  studentId   Int      @unique
  optInPublic Boolean  @default(false)
  nickname    String?
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

/// Conquista do aluno (codigos em ranking-rules.ts). Codigos 'LEAGUE_*' sao marcadores internos de "liga ja
/// notificada" (nao aparecem como conquista), para nunca notificar a mesma liga duas vezes.
model Achievement {
  id        Int      @id @default(autoincrement())
  studentId Int
  code      String
  earnedAt  DateTime
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
}

/// Resultado de uma temporada FECHADA (snapshot dos top 10). scope: GROUP (scopeKey = id do grupo; alunos do grupo),
/// COUNTRY (scopeKey 'BR'; alunos com opt-in) ou GROUPS_COUNTRY (scopeKey 'BR'; grupos, points = media por aluno).
/// Sem FK de proposito: e' historico imutavel. Idempotente: o fechamento pula (season, scope, scopeKey) ja gravado.
model SeasonResult {
  id             Int      @id @default(autoincrement())
  season         String
  scope          String
  scopeKey       String
  rank           Int
  studentId      Int?
  organizationId Int?
  points         Int
  createdAt      DateTime @default(now())

  @@unique([season, scope, scopeKey, rank])
  @@index([season])
}
