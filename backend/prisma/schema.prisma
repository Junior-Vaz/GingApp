// GingApp — schema Prisma
// Modelado a partir de PLANO_PROJETO.md, secao 2 (Banco de Dados).
// Estrategia de multi-tenancy: isolamento em camada de aplicacao (nao ha RLS no Postgres).
// Toda entidade "privada" de um grupo carrega organizationId e todo service DEVE filtrar por ele.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserType {
  MEMBER
  PLATFORM
}

/// Papel do usuario dentro de uma organizacao especifica (vive em OrganizationUser,
/// nao em User, porque a mesma pessoa pode ter papeis diferentes em grupos diferentes).
enum OrgRole {
  MESTRE
  PROFESSOR
  ALUNO
  RESPONSAVEL
  /// Fase 3 da ficha unica (cargos): professor limitado (sem excluir, sem graduar/emitir certificado, sem financeiro).
  INSTRUTOR
  /// Fase 3: monitor (le alunos/turmas/aulas e faz chamada; sem financeiro).
  MONITOR
}

/// Cargo capoeiristico ACUMULAVEL por pessoa e grupo (Fase 3, docs/FICHA_UNICA.md). Hierarquia:
/// MESTRE > PROFESSOR > INSTRUTOR > MONITOR. O MAIOR cargo ativo vira o OrganizationUser.role (permissao/RBAC).
enum StaffRole {
  MESTRE
  PROFESSOR
  INSTRUTOR
  MONITOR
}

/// Tipo de organizacao. SYSTEM e reservado para a organizacao "fantasma" (id fixo) usada
/// apenas por seed/health-check de contas PLATFORM, que nao pertencem a nenhum grupo real
/// (PLANO_PROJETO.md §2.2). GROUP e um grupo de capoeira real (tenant).
enum OrganizationType {
  SYSTEM
  GROUP
}

/// Status generico para entidades de organizacao sem regra de negocio propria de status
/// (decisao de modelagem: o plano so especifica literalmente `status String @default("ACTIVE")`
/// para User e OrganizationUser; para as demais entidades foi adotado este enum para dar
/// type-safety sem inventar estados que o plano nao pediu).
enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Estilo visual da corda de graduacao (GraduationLevel.style).
enum RopeStyle {
  SOLID
  SPLIT
  BRAIDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  FORMER
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Forma de pagamento da baixa de um lançamento (E07).
enum PaymentMethod {
  CASH
  PIX
  CARD
  TRANSFER
  OTHER
}

/// Origem da baixa de um lancamento: MANUAL (POST /finance/:id/pay, PATCH) ou PIX_AUTO (Pix confirmado pelo provedor de
/// pagamento - webhook/sincronizacao, ver interface/http/payments). NULL em lancamentos pagos antes desta coluna (= manual).
enum PaidVia {
  MANUAL
  PIX_AUTO
}

/// Situacao da conta do provedor de pagamento (OAuth do vendedor) de um grupo.
/// CONNECTED = tokens validos; REVOKED = desconectada pelo Mestre (tokens apagados); ERROR = renovacao do token falhou
/// (o Mestre precisa reconectar).
enum PaymentAccountStatus {
  CONNECTED
  REVOKED
  ERROR
}

/// Como a conta do provedor do grupo foi ligada (PLANO_PROJETO.md 10.55): MANUAL = o Mestre colou o Access Token da
/// PROPRIA conta na tela de configuracao do painel (caminho principal; token sem refresh/expiracao); OAUTH = fluxo OAuth
/// do vendedor (opcional, dormente sem MERCADOPAGO_CLIENT_ID/SECRET/REDIRECT_URI no servidor).
enum PaymentAccountMode {
  MANUAL
  OAUTH
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
  CANCELLED
  /// Lista de espera de evento lotado (Event.capacity): nao ocupa vaga; o primeiro da fila (menor id) e promovido a
  /// CONFIRMED quando uma vaga abre.
  WAITLIST
}

/// Situacao de publicacao do evento: DRAFT (so a equipe ve), PUBLISHED (aberto), CANCELLED (cancelado: inscritos
/// notificados, sem novas inscricoes), CLOSED (encerrado: sem novas inscricoes).
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  CLOSED
}

/// Recorrencia de uma roda (so a roda "mae" tem; as ocorrencias geradas ficam NONE + parentRodaId):
/// WEEKLY = todo mesmo dia da semana; MONTHLY_WEEKDAY = "toda 1a sexta" (n-esimo dia da semana do mes, derivado de
/// Roda.date); MONTHLY_DAY = "todo dia X" (dia do mes de Roda.date, limitado ao ultimo dia dos meses curtos).
enum RodaRecurrence {
  NONE
  WEEKLY
  MONTHLY_WEEKDAY
  MONTHLY_DAY
}

// =========================================================================
// PLATAFORMA (GestorPrint-style)
// =========================================================================

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  passwordHash            String
  name                    String
  phone                   String?
  photo                   String?
  userType                UserType  @default(MEMBER)
  isSuperAdmin            Boolean   @default(false)
  status                  String    @default("ACTIVE")
  /// 2FA TOTP (RFC 6238), opt-in. O segredo fica CIFRADO em repouso (AES-256-GCM, ver
  /// shared/security/two-factor-crypto.ts) e nunca e' devolvido depois do setup. Enquanto
  /// twoFactorEnabled=false o segredo e' so' um setup pendente (ainda nao confirmado com um codigo).
  twoFactorSecret         String?
  twoFactorEnabled        Boolean   @default(false)
  /// Hashes (HMAC-SHA256) dos codigos de recuperacao ainda NAO usados; cada um vale uma unica vez.
  twoFactorRecoveryHashes String[]  @default([])
  /// Ultimo passo de 30 s de TOTP aceito (anti-replay: o mesmo codigo nao vale duas vezes).
  twoFactorLastStep       Int?
  tokenValidAfter         DateTime?
  /// true quando a senha atual foi definida por outra pessoa (conta de aluno/responsavel criada pelo
  /// Mestre/Professor, ou senha redefinida por ele): os frontends devem exigir a troca no proximo login.
  /// Limpo por POST /auth/change-password.
  mustChangePassword      Boolean   @default(false)
  /// Aceite dos Termos de Uso + Politica de Privacidade (LGPD, E10): versao do texto aceita pelo titular
  /// (ver backend/src/shared/legal) e quando. NULL = nunca aceitou. Um texto novo (versao diferente da
  /// atual) volta a exigir o aceite. O servidor so BLOQUEIA o uso se TERMS_ENFORCEMENT=true; por padrao
  /// quem barra e o frontend (modal bloqueante), para nao quebrar seed/demo/e2e.
  acceptedTermsVersion    String?
  acceptedTermsAt         DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  memberships                  OrganizationUser[]
  unitAccess                   UserUnitAccess[]
  auditLogs                    AuditLog[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  pushPreference               PushPreference?
  createdAnnouncements         Announcement[]         @relation("AnnouncementCreatedBy")
  createdPlatformAnnouncements PlatformAnnouncement[] @relation("PlatformAnnouncementCreatedBy")
  studentLinks                 Student[]              @relation("StudentUser")
  person                       Person?                @relation("PersonUser")
  requestedTransfers           TransferRequest[]      @relation("TransferRequestedBy")
  staffRoles                   PersonRole[]           @relation("PersonRoleUser")
  guardianLinks                StudentGuardian[]      @relation("StudentGuardianUser")
  taughtLessons                Lesson[]               @relation("LessonTeacher")
  taughtClasses                Class[]                @relation("ClassTeacher")
  eventParticipations          EventParticipant[]     @relation("EventParticipantUser")
  rodaParticipations           RodaParticipant[]      @relation("RodaParticipantUser")
  publicProfile                PublicProfile?         @relation("PublicProfileUser")
  updatedPlatformSettings      PlatformSetting[]      @relation("PlatformSettingUpdatedBy")
  dataDeletionRequests         DataDeletionRequest[]  @relation("DataDeletionRequestUser")
  passwordResetTokens          PasswordResetToken[]   @relation("PasswordResetTokenUser")
  uploads                      Upload[]               @relation("UploadUser")
  birthdayGreetingsSent        BirthdayGreeting[]     @relation("BirthdayGreetingGreeter")
  birthdayCongratsGiven        BirthdayCongrats[]     @relation("BirthdayCongratsGiver")
  announcementAcks             AnnouncementAck[]      @relation("AnnouncementAckUser")
  feedPosts                    FeedPost[]             @relation("FeedPostAuthor")
  feedPostsApproved            FeedPost[]             @relation("FeedPostApprovedBy")
  feedMediaUploaded            FeedPostMedia[]        @relation("FeedMediaUploader")
  feedReactions                FeedReaction[]         @relation("FeedReactionUser")
  feedComments                 FeedComment[]          @relation("FeedCommentAuthor")
  feedReportsMade              FeedReport[]           @relation("FeedReportReporter")
  feedReportsResolved          FeedReport[]           @relation("FeedReportResolver")
  feedStoryViews               FeedStoryView[]        @relation("FeedStoryViewUser")

  @@index([userType])
}

/// Token de uso unico para definir/redefinir a senha por e-mail (E05): "esqueci a senha" (purpose RESET, 1 h)
/// e convite de aluno/responsavel (purpose INVITE, 72 h). O token em claro so existe no link enviado por
/// e-mail; aqui fica apenas o SHA-256 (tokenHash). Um pedido novo invalida os anteriores (usedAt).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  /// RESET | INVITE
  purpose   String    @default("RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("PasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

/// Pedido do titular para excluir/anonimizar os proprios dados (LGPD art. 18, E10). POST /auth/me/delete-request
/// apenas REGISTRA o pedido (status PENDING): nada e apagado automaticamente — a equipe/Mestre avalia (ha
/// historico escolar/financeiro a preservar) e executa manualmente, depois marca RESOLVED/REJECTED.
model DataDeletionRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  /// Grupo do token no momento do pedido (NULL para equipe PLATFORM).
  organizationId Int?
  /// PENDING | IN_PROGRESS | DONE | REJECTED (texto livre de proposito, como Notification.type).
  status         String    @default("PENDING")
  reason         String?
  requestedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  user User @relation("DataDeletionRequestUser", fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, requestedAt])
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String
  code          String   @unique
  priceCents    Int      @default(0)
  billingPeriod String   @default("MONTHLY")
  maxUnits      Int?
  maxStudents   Int?
  features      Json     @default("{}")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

/// gatewayProvider/gatewayCustomerId/gatewaySubscriptionId: referencia do gateway de pagamento
/// externo (Fase 2, PLANO_PROJETO.md §10.13). "stub" por enquanto (BillingGatewayService
/// simulado, sem credenciais reais de nenhum gateway) — trocar por "asaas"/"stripe"/etc quando
/// houver credenciais de verdade, sem precisar de migration nova (os campos já existem).
model Subscription {
  id                    Int                @id @default(autoincrement())
  organizationId        Int
  planId                Int
  status                SubscriptionStatus @default(TRIALING)
  gatewayProvider       String             @default("stub")
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  startedAt             DateTime           @default(now())
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  plan         Plan                @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]

  @@index([organizationId, status])
}

model SubscriptionEvent {
  id             Int      @id @default(autoincrement())
  subscriptionId Int
  type           String
  payload        Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, createdAt])
}

model OrganizationFeatureOverride {
  id             Int      @id @default(autoincrement())
  organizationId Int
  featureKey     String
  enabled        Boolean  @default(true)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureKey])
}

model RolePermission {
  id        Int     @id @default(autoincrement())
  role      OrgRole
  resource  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, resource])
}

model PlatformSetting {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           Json
  isSecret        Boolean  @default(false)
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  updatedByUser User? @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id])
}

model PlatformAnnouncement {
  id                   Int       @id @default(autoincrement())
  title                String
  body                 String
  targetOrganizationId Int?
  publishedAt          DateTime?
  expiresAt            DateTime?
  isActive             Boolean   @default(true)
  createdByUserId      Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  createdByUser      User          @relation("PlatformAnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  targetOrganization Organization? @relation(fields: [targetOrganizationId], references: [id])

  @@index([isActive, publishedAt])
}

/// Trilha de auditoria unica (plataforma + grupo). organizationId nulo = acao de escopo
/// de plataforma (ex.: platform-login, alteracao de plano).
model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// =========================================================================
// ORGANIZACAO (dominio do projeto.txt)
// =========================================================================

model Organization {
  id                      Int              @id @default(autoincrement())
  name                    String
  slug                    String           @unique
  type                    OrganizationType @default(GROUP)
  status                  RecordStatus     @default(ACTIVE)
  document                String?
  email                   String?
  phone                   String?
  logo                    String?
  /// Perfil institucional do grupo (projeto.txt §13), editado pelo MESTRE em PATCH /organizations/me.
  /// description = apresentacao curta; history = historia do grupo; foundedYear = ano de fundacao;
  /// city/state = cidade e UF-sede (texto livre, nao FK); website = site; socialLinks = redes
  /// ({ instagram?, youtube?, tiktok?, facebook?, whatsapp? }, todas opcionais, so URLs).
  description             String?
  history                 String?
  foundedYear             Int?
  city                    String?
  state                   String?
  website                 String?
  socialLinks             Json?
  /// "Como pagar" (E07): texto livre (chave PIX, dados bancarios, link, orientacoes) mostrado ao aluno/
  /// responsavel no app. Editado pelo MESTRE em PATCH /organizations/me.
  paymentInstructions     String?
  /// Mapa da comunidade (GET /map/places): o MESTRE controla se o grupo (unidades, treinos, eventos publicos e
  /// rodas organizadas por ele) aparece no mapa. Padrao true; grupo INACTIVE nunca aparece, qualquer que seja o valor.
  mapVisible              Boolean          @default(true)
  /// Aviso de presenca (push/sino): quando a chamada de uma aula marca o aluno PRESENTE, ele e os responsaveis com
  /// login recebem "Presenca registrada". O MESTRE liga/desliga em PATCH /organizations/me. Padrao true.
  attendanceNotifications Boolean          @default(true)
  /// Aniversariantes (docs/CONTRATO_FEED_ANIVERSARIOS_COMUNICACAO.md §2), editado pelo MESTRE em PUT /birthdays/settings:
  /// resumo diario aos gestores (07:30 SP), parabens automaticos (desligado por padrao) com mensagem propria
  /// (nulo = mensagem padrao) e hora (0..23, SP) do envio.
  birthdayDailyDigest     Boolean          @default(true)
  birthdayAutoGreeting    Boolean          @default(false)
  birthdayGreetingMessage String?
  birthdayGreetingHour    Int              @default(8)
  /// Feed do grupo (contrato §4), editado pelo MESTRE em PUT /feed/settings. feedBlockedWords = palavras que mandam
  /// o post para aprovacao (comparacao sem acento/caixa feita no backend).
  feedEnabled             Boolean          @default(false)
  feedPostingMode         FeedPostingMode  @default(MODERATED)
  feedAllowComments       Boolean          @default(true)
  feedBlockedWords        String[]         @default([])
  /// Opcao do MESTRE: menor de 18 anos publica direto (sem a aprovacao obrigatoria de menor). Padrao false.
  feedMinorsPostDirectly  Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  birthdayGreetings       BirthdayGreeting[]
  birthdayCongrats        BirthdayCongrats[]
  announcementAcks        AnnouncementAck[]
  feedPosts               FeedPost[]
  feedMedia               FeedPostMedia[]
  feedComments            FeedComment[]
  feedReports             FeedReport[]
  studentBillings         StudentBilling[]
  users                   OrganizationUser[]
  units                   Unit[]
  userUnitAccess          UserUnitAccess[]
  students                Student[]
  studentGuardians        StudentGuardian[]
  classes                 Class[]
  classStudents           ClassStudent[]
  lessons                 Lesson[]
  attendances             Attendance[]
  attendanceNotices       AttendanceNotice[]
  graduationSystems       GraduationSystem[]
  graduationLevels        GraduationLevel[]
  studentGraduations      StudentGraduation[]
  financialRecords        FinancialRecord[]
  events                  Event[]
  eventParticipants       EventParticipant[]
  announcements           Announcement[]
  quickNoticeTemplates    QuickNoticeTemplate[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  subscriptions           Subscription[]
  featureOverrides        OrganizationFeatureOverride[]
  auditLogs               AuditLog[]
  platformAnnouncements   PlatformAnnouncement[]
  publicProfiles          PublicProfile[]
  certificates            Certificate[]
  certificateTemplates    CertificateTemplate[]
  rodas                   Roda[]
  uploads                 Upload[]
  pointEvents             PointEvent[]
  transfersOut            TransferRequest[]             @relation("TransferFrom")
  transfersIn             TransferRequest[]             @relation("TransferTo")
  personRoles             PersonRole[]
  groupRoles              GroupRole[]
  paymentAccounts         PaymentProviderAccount[]
  registrationForms       RegistrationForm[]
  registrationSubmissions RegistrationSubmission[]
  registrationFiles       RegistrationSubmissionFile[]

  @@index([status])
}

/// Imagem enviada por POST /uploads (foto de aluno, logo do grupo, capa de evento/roda, perfil no app).
/// O arquivo fica em disco (UPLOADS_DIR, volume Docker gingapp_uploads) com nome aleatorio (uuid) em
/// `filename`; esta linha guarda a que grupo/usuario ele pertence e o tamanho (cota por grupo).
model Upload {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  /// Nome do arquivo em disco (uuid + extensao): o mesmo que aparece na URL /api/uploads/<filename>.
  filename       String   @unique
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("UploadUser", fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

model OrganizationUser {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  role           OrgRole
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

model Unit {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  address        String?
  city           String?
  state          String?
  /// Coordenadas para o mapa da comunidade (opcionais): informadas pelo usuario ou geocodificadas
  /// (shared/geo/geocoding.service.ts) a partir de address/city/state quando ha chave do Google.
  latitude       Float?
  longitude      Float?
  /// Foto da unidade (URL http(s) ou /api/uploads/<uuid>.<ext>, validada por IsImageRef). Aparece nas turmas/aulas e no mapa.
  photo          String?
  isMain         Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  userAccess       UserUnitAccess[]
  students         Student[]
  classes          Class[]
  lessons          Lesson[]
  financialRecords FinancialRecord[]
  events           Event[]
  announcements    Announcement[]
  feedPosts        FeedPost[]

  @@index([organizationId, status])
  @@index([latitude, longitude])
}

/// Professor autorizado em multiplas unidades (matriz/filial) dentro de uma mesma
/// organizacao — PLANO_PROJETO.md §3.2 item 5.
model UserUnitAccess {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int
  unitId         Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId])
  @@index([organizationId])
}

model Student {
  id             Int           @id @default(autoincrement())
  organizationId Int
  unitId         Int?
  /// Um User pode ser aluno em VARIOS grupos (um Student por organizacao): unicidade so por (organizationId, userId).
  /// NULLs repetidos sao permitidos (aluno sem login).
  userId         Int?
  name           String
  birthDate      DateTime?
  document       String?
  phone          String?
  email          String?
  photo          String?
  /// Ficha unica (docs/FICHA_UNICA.md): a PESSOA dona desta matricula. Student = matricula da pessoa NESTE grupo
  /// (situacao, unidade, turma, mensalidade, frequencia, graduacoes concedidas pelo grupo); Person = identidade global.
  /// Nulo so em linhas antigas ainda nao processadas pelo backfill (npm run person:backfill / boot) ou criadas fora
  /// da API (seed/specs): PeopleService.ensurePersonForStudent completa sob demanda. NOT NULL numa fase futura.
  personId       Int?
  /// URL de uma foto de capa/fundo pro cartão de perfil no PWA (mesmo padrão leve de photo
  /// acima — só URL, sem upload). Auto-atendimento: o próprio aluno/responsável define a sua
  /// via PATCH /students/me/profile — não é um campo gerenciado pelo painel/admin.
  coverPhoto     String?
  /// Links de redes sociais do praticante ({ instagram?, youtube?, tiktok?, facebook?,
  /// whatsapp? }, todos opcionais) — mesmo raciocínio de auto-atendimento do coverPhoto acima.
  socialLinks    Json?
  status         StudentStatus @default(ACTIVE)
  joinedAt       DateTime?
  /// Fim da matricula (Fase 2): preenchido quando a pessoa sai do grupo por transferencia (leftReason 'TRANSFER').
  leftAt         DateTime?
  leftReason     String?
  /// Fase 3: matricula criada para alguem da EQUIPE (todo mundo e aluno). Nao conta no limite de alunos do plano
  /// (Plan.maxStudents) e nao gera mensalidade (so quem tem StudentBilling e cobrado).
  isStaff        Boolean       @default(false)
  /// LGPD: matricula anonimizada junto com a ficha (nome 'Pessoa removida', sem contato/documento/foto).
  anonymizedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id])
  unit                Unit?                  @relation(fields: [unitId], references: [id])
  user                User?                  @relation("StudentUser", fields: [userId], references: [id])
  person              Person?                @relation(fields: [personId], references: [id], onDelete: SetNull)
  guardians           StudentGuardian[]
  classStudents       ClassStudent[]
  attendances         Attendance[]
  attendanceNotices   AttendanceNotice[]
  graduations         StudentGraduation[]
  financialRecords    FinancialRecord[]
  eventParticipations EventParticipant[]
  rodaParticipations  RodaParticipant[]
  publicProfile       PublicProfile?         @relation("PublicProfileStudent")
  certificates        Certificate[]
  billing             StudentBilling?
  pointEvents         PointEvent[]
  rankingProfile      RankingProfile?
  achievements        Achievement[]
  roleNotices         RoleSuggestionNotice[]
  occurrences         Occurrence[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@index([personId])
}

/// Tipo do documento que identifica a Person (chave de busca sem duplicar): CPF proprio; GUARDIAN_CPF = crianca sem
/// CPF identificada pelo CPF do responsavel + data de nascimento; PASSPORT reservado (estrangeiros; sem fluxo ainda).
enum PersonDocumentKind {
  CPF
  GUARDIAN_CPF
  PASSPORT
}

/// FICHA UNICA do capoeirista (docs/FICHA_UNICA.md): uma linha por PESSOA no GingApp inteiro, ligada ao CPF. As
/// matriculas (Student) de todos os grupos apontam para ela. Dados de identidade; nada de financeiro/frequencia aqui.
/// O documento NUNCA fica em claro: documentEnc = AES-256-GCM (PERSON_DOC_KEY), documentHash = HMAC-SHA256 do
/// documento normalizado (PERSON_DOC_PEPPER) para busca exata, documentLast4 = so para exibir a mascara.
/// Mescla (POST /people/merge): a ficha mesclada NAO e apagada; ganha mergedIntoId (o codigo/CPF antigos continuam
/// encontrando a ficha mantida seguindo essa cadeia).
model Person {
  id              Int                 @id @default(autoincrement())
  /// Codigo legivel unico por pessoa (GING-XXXX-XXXX, alfabeto sem 0/O/1/I, ultimo caractere = verificador).
  gingappCode     String              @unique
  name            String
  nickname        String?
  birthDate       DateTime?
  /// Opt-out do aniversario no grupo/app (contrato §2): false = nao aparece em /birthdays/week nem recebe parabens de colegas.
  birthdayVisible Boolean             @default(true)
  photo           String?
  gender          String?
  email           String?
  phone           String?
  documentHash    String?             @unique
  documentEnc     String?
  documentLast4   String?
  documentKind    PersonDocumentKind?
  /// Login da pessoa (no maximo uma ficha por User).
  userId          Int?                @unique
  mergedIntoId    Int?
  mergedAt        DateTime?
  /// LGPD: ficha anonimizada (pedido de exclusao tratado pelo super admin). Os dados pessoais foram removidos; o id e
  /// o gingappCode (trocado por um codigo novo) ficam so para a integridade historica.
  anonymizedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user              User?              @relation("PersonUser", fields: [userId], references: [id], onDelete: SetNull)
  mergedInto        Person?            @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        Person[]           @relation("PersonMerge")
  students          Student[]
  transfers         TransferRequest[]
  roles             PersonRole[]
  birthdayGreetings BirthdayGreeting[]
  birthdayCongrats  BirthdayCongrats[]
  feedPosts         FeedPost[]

  @@index([birthDate])
  @@index([mergedIntoId])
}

/// Situacao de um pedido de transferencia (docs/FICHA_UNICA.md, Fase 2). PENDING_PERSON = aguardando a pessoa (ou o
/// responsavel do menor); APPROVED = aprovado, matricula nova criada e janela de contestacao do grupo antigo ainda
/// aberta; COMPLETED = aprovado e janela encerrada (job diario); DECLINED/CANCELLED/EXPIRED = encerrado sem mudanca.
enum TransferStatus {
  PENDING_PERSON
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
}

/// Motivo estruturado da contestacao do grupo antigo (nao bloqueia a transferencia).
enum TransferContestReason {
  PENDING_PAYMENT
  EQUIPMENT
  OTHER
}

/// Pedido de transferencia da PESSOA (ficha unica) de um grupo para outro. Feito pelo MESTRE do grupo novo; decidido
/// pela pessoa (ou responsavel, se menor). 1 pedido PENDING_PERSON por pessoa+grupo destino (conferido em transacao
/// com trava na Person).
model TransferRequest {
  id                 Int            @id @default(autoincrement())
  personId           Int
  fromOrganizationId Int
  /// Matricula de origem (a mais recente da pessoa no grupo antigo).
  fromStudentId      Int?
  toOrganizationId   Int
  /// Unidade desejada no grupo novo (opcional) e matricula criada na aprovacao.
  toUnitId           Int?
  toStudentId        Int?
  requestedByUserId  Int
  decidedByUserId    Int?
  status             TransferStatus @default(PENDING_PERSON)
  requestedAt        DateTime       @default(now())
  decidedAt          DateTime?
  expiresAt          DateTime
  /// Ate quando o grupo antigo pode contestar pendencias (a partir do pedido; nao bloqueia a saida).
  contestUntil       DateTime
  note               String?
  updatedAt          DateTime       @updatedAt

  person           Person                  @relation(fields: [personId], references: [id])
  fromOrganization Organization            @relation("TransferFrom", fields: [fromOrganizationId], references: [id])
  toOrganization   Organization            @relation("TransferTo", fields: [toOrganizationId], references: [id])
  requestedBy      User                    @relation("TransferRequestedBy", fields: [requestedByUserId], references: [id])
  contests         TransferContest[]
  shares           EnrollmentShare[]
  approvalTokens   TransferApprovalToken[]

  @@index([personId, status])
  @@index([toOrganizationId, status])
  @@index([fromOrganizationId, status])
  @@index([status, expiresAt])
}

/// Convite guiado: link de aprovacao de uso unico para ADULTO SEM LOGIN aprovar a transferencia. So o SHA-256 do token
/// fica no banco; expira junto com o pedido; gerar outro invalida os anteriores (usedAt).
model TransferApprovalToken {
  id        Int       @id @default(autoincrement())
  requestId Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  request TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, usedAt])
  @@index([expiresAt])
}

/// Contestacao do grupo antigo (pendencia financeira, material, outro + texto curto). Informativa: a pessoa e o grupo
/// novo veem; nunca bloqueia a transferencia.
model TransferContest {
  id             Int                   @id @default(autoincrement())
  requestId      Int
  organizationId Int
  byUserId       Int
  reason         TransferContestReason
  note           String?
  createdAt      DateTime              @default(now())

  request TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// Compartilhamento (somente leitura) do historico de UMA matricula antiga com o grupo novo, criado na aprovacao da
/// transferencia: frequencia por turma, graduacoes e certificados (nunca financeiro). revokedAt = deixa de valer.
model EnrollmentShare {
  id                 Int       @id @default(autoincrement())
  personId           Int
  fromStudentId      Int
  fromOrganizationId Int
  toOrganizationId   Int
  requestId          Int
  grantedAt          DateTime  @default(now())
  revokedAt          DateTime?

  request TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([fromStudentId, toOrganizationId])
  @@index([personId, toOrganizationId])
}

/// Cargo de uma pessoa num grupo (Fase 3). Historico: revogar preenche revokedAt (nunca apaga). Ativo = revokedAt nulo.
/// userId = login (obrigatorio para exercer o cargo); personId = ficha (preenchido pelo backfill/concessao).
model PersonRole {
  id              Int       @id @default(autoincrement())
  organizationId  Int
  userId          Int
  personId        Int?
  /// PERFIL DE ACESSO do cargo (copia de GroupRole.accessRole no momento da concessao; o maior entre os ativos vira o
  /// OrganizationUser.role). O accessRole de um GroupRole so muda quando ninguem o exerce, entao a copia nao diverge.
  role            StaffRole
  /// Cargo DO GRUPO (docs/FICHA_UNICA.md secao 13): nome/cor/icone/rank que o grupo definiu. Null so em historico de
  /// cargo excluido (o `role` acima preserva o acesso que valia).
  groupRoleId     Int?
  /// MIGRATION (papel MESTRE/PROFESSOR que ja existia), GRANT (concedido pelo Mestre), TEACHER (tela Equipe), ORG (criacao do grupo).
  source          String    @default("GRANT")
  grantedAt       DateTime  @default(now())
  grantedByUserId Int?
  revokedAt       DateTime?
  revokedByUserId Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("PersonRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  groupRole    GroupRole?   @relation(fields: [groupRoleId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, revokedAt])
  @@index([personId])
  @@index([groupRoleId, revokedAt])
}

/// CARGO DO GRUPO (docs/FICHA_UNICA.md secao 13): cada grupo cria/edita os seus (Contramestre, Formado, Monitor...).
/// accessRole = PERFIL DE ACESSO base (um dos papeis da matriz: MESTRE|PROFESSOR|INSTRUTOR|MONITOR; ALUNO nao e cargo).
/// rank = hierarquia visual (maior = mais senior): ordena listas, escolhe o selo principal e a arvore da Jornada.
/// isDefault = os 4 cargos padrao (slug mestre/professor/instrutor/monitor; nunca excluidos, so renomeados/inativados).
model GroupRole {
  id             Int       @id @default(autoincrement())
  organizationId Int
  name           String
  /// Identificador estavel (kebab, unico no grupo; nao muda ao renomear). roleKeys das respostas = slugs.
  slug           String
  accessRole     StaffRole
  rank           Int
  /// Cor hex (#RRGGBB) do selo.
  color          String?
  /// Nome curto de icone lucide (lista permitida em roles/group-roles.ts).
  icon           String?
  isDefault      Boolean   @default(false)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personRoles  PersonRole[]
  rules        GraduationRoleRule[]
  notices      RoleSuggestionNotice[]

  @@unique([organizationId, slug])
  @@index([organizationId, rank])
}

/// Regra do sistema de graduacao do grupo: a partir de qual corda (GraduationLevel.order) o cargo DO GRUPO e possivel
/// (o sistema SUGERE; o Mestre confirma). `role` = copia do accessRole do cargo (legado/consulta).
model GraduationRoleRule {
  id                 Int       @id @default(autoincrement())
  organizationId     Int
  graduationSystemId Int
  role               StaffRole
  groupRoleId        Int?
  minLevelOrder      Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  graduationSystem GraduationSystem @relation(fields: [graduationSystemId], references: [id], onDelete: Cascade)
  groupRole        GroupRole?       @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)

  @@unique([graduationSystemId, groupRoleId])
  @@index([organizationId])
}

/// Fase 4 (ficha unica): tipo de ocorrencia disciplinar.
enum OccurrenceKind {
  ADVERTENCIA
  SUSPENSAO
  EXPULSAO
  OUTRA
}

/// ACTIVE = valendo; CONTESTED = a pessoa (ou responsavel) contestou (continua visivel com o selo); RETRACTED = o Mestre autor retratou.
enum OccurrenceStatus {
  ACTIVE
  CONTESTED
  RETRACTED
}

/// Ocorrencia (punicao/expulsao) registrada pelo MESTRE do grupo sobre uma matricula (Fase 4, docs/FICHA_UNICA.md secao 6).
/// DADO SENSIVEL: le/escreve so o MESTRE do grupo da matricula; o MESTRE do grupo novo le (somente leitura) via
/// EnrollmentShare ativo; a propria pessoa (ou o responsavel do menor) ve e contesta. Nunca alunos/professores/instrutores/monitores.
/// Sem purga automatica (retencao documentada).
model Occurrence {
  id                 Int              @id @default(autoincrement())
  organizationId     Int
  studentId          Int
  personId           Int?
  kind               OccurrenceKind
  occurredAt         DateTime
  /// Fim da suspensao (so SUSPENSAO).
  endsAt             DateTime?
  reason             String
  status             OccurrenceStatus @default(ACTIVE)
  /// true = a expulsao encerrou a matricula (Student FORMER, leftReason EXPELLED).
  expelledEnrollment Boolean          @default(false)
  createdByUserId    Int?
  contestedAt        DateTime?
  contestNote        String?
  contestedByUserId  Int?
  retractedAt        DateTime?
  retractNote        String?
  retractedByUserId  Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId, studentId])
  @@index([personId])
}

/// Fase 5: equivalencia de corda declarada pelo grupo NOVO: a corda `fromLevelId` (de outro grupo) vale `toLevelId` (deste grupo).
model LevelEquivalence {
  id               Int      @id @default(autoincrement())
  toOrganizationId Int
  fromLevelId      Int
  toLevelId        Int
  declaredByUserId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromLevel GraduationLevel @relation("EquivalenceFrom", fields: [fromLevelId], references: [id], onDelete: Cascade)
  toLevel   GraduationLevel @relation("EquivalenceTo", fields: [toLevelId], references: [id], onDelete: Cascade)

  @@unique([toOrganizationId, fromLevelId])
}

/// Marcador "o Mestre ja foi avisado de que esta matricula atingiu a corda deste cargo" (1 aviso por aluno+cargo).
model RoleSuggestionNotice {
  id             Int       @id @default(autoincrement())
  organizationId Int
  studentId      Int
  role           StaffRole
  groupRoleId    Int?
  createdAt      DateTime  @default(now())

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupRole GroupRole? @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupRoleId])
}

/// Cobranca mensal do aluno (E07): valor da mensalidade (centavos) e dia de vencimento (1..31; em meses
/// curtos vale o ultimo dia do mes). Tabela PROPRIA (nao colunas de Student) de proposito: o financeiro e
/// so do MESTRE, e GET /students e lido por professor — o valor nao pode vazar por la.
model StudentBilling {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  studentId       Int      @unique
  monthlyFeeCents Int
  dueDay          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Responsavel legal do aluno (obrigatorio quando o aluno e menor de idade, por birthDate —
/// PLANO_PROJETO.md §3.4). userId e opcional: um responsavel pode ou nao ter login proprio
/// no app.gingapp.com.br (decisao de modelagem, plano nao detalha o formato exato).
model StudentGuardian {
  id                   Int      @id @default(autoincrement())
  organizationId       Int
  studentId            Int
  userId               Int?
  name                 String
  relationship         String?
  phone                String?
  email                String?
  consentPublicProfile Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  user           User?           @relation("StudentGuardianUser", fields: [userId], references: [id])
  publicProfiles PublicProfile[] @relation("PublicProfileGuardianConsent")

  @@index([organizationId])
  @@index([studentId])
}

model Class {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  unitId              Int?
  name                String
  description         String?
  weekday             Int?
  startTime           String?
  endTime             String?
  /// Professor responsavel pela turma: User.id de um membro ATIVO MESTRE/PROFESSOR do mesmo
  /// grupo (validado no service, mesmo padrao de Lesson.teacherUserId). Copiado para as aulas
  /// geradas por POST /classes/:id/generate-lessons.
  teacherUserId       Int?
  /// Foto da turma (URL http(s) ou /api/uploads/<uuid>.<ext>, validada por IsImageRef).
  photo               String?
  /// Aulas continuas (sem data final): true = o job diario (e o ensureHorizon ao criar/editar a turma) mantem as
  /// aulas geradas ate LESSONS_HORIZON_DAYS a frente, a partir do weekday/horario da turma. Turmas ja existentes
  /// migram com true (passam a ter aulas geradas automaticamente); false = so geracao manual por periodo.
  autoGenerateLessons Boolean      @default(true)
  /// Local do treino PROPRIO da turma (opcional): mesmo desenho da Unit (address/city/state + latitude/longitude,
  /// geocodificados por shared/geo/geocoding.service.ts) + um rotulo livre (ex.: "Praca X"). Tudo null = a turma
  /// herda o endereco/coordenadas da unidade (comportamento de sempre; turmas antigas continuam assim).
  locationLabel       String?
  address             String?
  city                String?
  state               String?
  latitude            Float?
  longitude           Float?
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])
  teacher       User?          @relation("ClassTeacher", fields: [teacherUserId], references: [id])
  classStudents ClassStudent[]
  lessons       Lesson[]
  announcements Announcement[]
  feedPosts     FeedPost[]

  @@index([organizationId, status])
  @@index([teacherUserId])
  @@index([latitude, longitude])
}

model ClassStudent {
  id             Int          @id @default(autoincrement())
  organizationId Int
  classId        Int
  studentId      Int
  status         RecordStatus @default(ACTIVE)
  enrolledAt     DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
  @@index([organizationId])
}

model Lesson {
  id             Int          @id @default(autoincrement())
  organizationId Int
  classId        Int
  unitId         Int?
  teacherUserId  Int?
  date           DateTime
  startTime      String?
  endTime        String?
  notes          String?
  status         RecordStatus @default(ACTIVE)
  /// Quando a aula foi cancelada (status INACTIVE); o app esconde a aula cancelada 2 dias depois.
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  class             Class              @relation(fields: [classId], references: [id])
  unit              Unit?              @relation(fields: [unitId], references: [id])
  teacher           User?              @relation("LessonTeacher", fields: [teacherUserId], references: [id])
  attendances       Attendance[]
  attendanceNotices AttendanceNotice[]

  @@index([organizationId, date])
  @@index([classId, date])
}

model Attendance {
  id             Int      @id @default(autoincrement())
  organizationId Int
  lessonId       Int
  studentId      Int
  present        Boolean  @default(true)
  justification  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  lesson       Lesson       @relation(fields: [lessonId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId, createdAt])
}

/// Idempotencia do aviso "Presenca registrada": uma linha por (aula, aluno) JA avisado. A chamada so notifica quando
/// consegue INSERIR a linha (INSERT ... ON CONFLICT DO NOTHING ... RETURNING) — re-salvar a chamada, o check-in por QR
/// depois da chamada ou duas requisicoes simultaneas nunca avisam duas vezes. Em cascata com aula/aluno/grupo.
model AttendanceNotice {
  id             Int      @id @default(autoincrement())
  organizationId Int
  lessonId       Int
  studentId      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([organizationId])
}

/// Sistema de graduacao configuravel por grupo (PLANO_PROJETO.md §2.3 e projeto.txt §26).
model GraduationSystem {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  levels       GraduationLevel[]
  roleRules    GraduationRoleRule[]

  @@index([organizationId])
}

model GraduationLevel {
  id                 Int       @id @default(autoincrement())
  organizationId     Int
  graduationSystemId Int
  name               String
  order              Int
  /// Cor PRIMARIA da corda (= colors[0]); mantida por compatibilidade com clientes antigos.
  color              String?
  /// Aparencia da corda: SOLID (1 cor), SPLIT (listras verticais/dividida, 2 ou 3 cores) ou BRAIDED (trancada: listras
  /// diagonais, 2 ou 3 cores). `colors` = 1 a 3 hex #RRGGBB, a ORDEM importa (validado no service/DTO).
  style              RopeStyle @default(SOLID)
  colors             String[]  @default([])
  /// Corda COM PONTAS: cor (#RRGGBB) da ponta de CIMA/primeira (~20% do comprimento); null = sem ponta. style/colors descrevem o CORPO.
  tipStart           String?
  /// Corda COM PONTAS: cor (#RRGGBB) da ponta de BAIXO/ultima; null = sem ponta. Independente de tipStart.
  tipEnd             String?
  createdAt          DateTime  @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  graduationSystem   GraduationSystem    @relation(fields: [graduationSystemId], references: [id])
  studentGraduations StudentGraduation[]
  equivalencesFrom   LevelEquivalence[]  @relation("EquivalenceFrom")
  equivalencesTo     LevelEquivalence[]  @relation("EquivalenceTo")

  @@unique([graduationSystemId, order])
  @@index([organizationId])
}

model StudentGraduation {
  id                    Int      @id @default(autoincrement())
  organizationId        Int
  studentId             Int
  graduationLevelId     Int
  graduatedAt           DateTime
  notes                 String?
  /// Fase 5: graduacao RECONHECIDA pelo grupo a partir da corda de origem (outro grupo) desta pessoa; null = graduacao normal.
  recognizedFromLevelId Int?
  createdAt             DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  graduationLevel GraduationLevel @relation(fields: [graduationLevelId], references: [id])
  certificates    Certificate[]

  @@index([studentId, createdAt])
}

/// amountCents: valores monetarios sempre em centavos (Int) para evitar erro de ponto
/// flutuante — decisao de modelagem, o plano nao especifica o tipo do campo.
model FinancialRecord {
  id               Int             @id @default(autoincrement())
  organizationId   Int
  studentId        Int?
  unitId           Int?
  description      String
  amountCents      Int
  type             String?
  dueDate          DateTime
  paidAt           DateTime?
  status           FinancialStatus @default(PENDING)
  /// Competencia 'YYYY-MM' (so nos lancamentos gerados em lote por POST /finance/generate-monthly); o
  /// unique (studentId, competence, type) garante 1 mensalidade por aluno+mes mesmo com chamadas
  /// concorrentes (NULLs sao distintos no Postgres: lancamentos avulsos nao sao afetados).
  competence       String?
  /// Baixa (E07): forma de pagamento e valor efetivamente pago (centavos; padrao = amountCents).
  paymentMethod    PaymentMethod?
  paidCents        Int?
  /// Origem da baixa (MANUAL | PIX_AUTO). So tem sentido com status PAID; a API devolve `paidVia` derivado (ver
  /// finance-record.view.ts): PAID sem valor aqui = MANUAL (lancamentos antigos).
  paidVia          PaidVia?
  /// Cobranca Pix no provedor de pagamento do GRUPO (Mercado Pago via OAuth; ver interface/http/payments). Nunca saem
  /// crus pela API: GET /finance e /finance/me devolvem so `pix: { status, expiresAt, generatedAt }`; o QR so vem de
  /// /finance/:id/pix. gatewayPaymentId = id do pagamento no provedor (unico por provider quando nao nulo).
  gatewayProvider  String?
  gatewayPaymentId String?
  /// Status CRU do provedor (MP: pending, approved, rejected, cancelled, refunded, charged_back, ...; 'expired' local).
  gatewayStatus    String?
  /// Pix copia-e-cola, imagem do QR (base64), link do provedor, validade e quando foi gerado.
  pixQrCode        String?
  pixQrCodeBase64  String?
  pixTicketUrl     String?
  pixExpiresAt     DateTime?
  pixGeneratedAt   DateTime?
  /// Valor (centavos) do Pix gerado: se o lancamento mudar de valor, o Pix antigo nao e reaproveitado.
  pixAmountCents   Int?
  /// Contador de Pix gerados para o lancamento (entra na chave de idempotencia enviada ao provedor).
  pixSeq           Int             @default(0)
  /// Ultima conferencia do Pix pela reconciliacao (fila justa: menos recente primeiro; tambem o "claim" atomico que
  /// impede duas replicas de conferirem o mesmo Pix na mesma rodada).
  pixLastCheckedAt DateTime?
  /// Conta do provedor (providerUserId) em que o Pix atual foi criado (PLANO_PROJETO.md 10.56, M3): se a conta do grupo
  /// mudou depois, o Pix vira 'account_changed' (terminal, alerta ao Mestre) em vez de 404 eterno na reconciliacao.
  gatewayAccountId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])

  @@unique([studentId, competence, type])
  @@unique([gatewayProvider, gatewayPaymentId])
  @@index([organizationId, status])
  @@index([studentId, dueDate])
  @@index([gatewayStatus, pixGeneratedAt])
  @@index([gatewayStatus, pixLastCheckedAt])
}

/// Conta do provedor de pagamento CONECTADA por um grupo (OAuth do vendedor - modelo marketplace): o dinheiro das
/// mensalidades cai na conta do PROPRIO grupo; o GingApp nunca toca no dinheiro. Tokens CIFRADOS (AES-256-GCM,
/// shared/payments/payment-crypto.ts) e NUNCA devolvidos em resposta, log ou auditoria. Uma conta por grupo e provider.
model PaymentProviderAccount {
  id               Int                  @id @default(autoincrement())
  organizationId   Int
  /// 'mercadopago' | 'stub' (PaymentProvider.id do servidor que conectou).
  provider         String
  /// user_id do vendedor no provedor (MP: collector_id dos pagamentos).
  providerUserId   String?
  accessTokenEnc   String?
  /// MANUAL: sempre null (sem refresh; a renovacao/cron pula a conta).
  refreshTokenEnc  String?
  /// MANUAL: sempre null (token de longa duracao colado pelo Mestre).
  tokenExpiresAt   DateTime?
  publicKey        String?
  liveMode         Boolean              @default(false)
  /// OAUTH para as linhas anteriores ao modo manual (PLANO_PROJETO.md 10.55).
  mode             PaymentAccountMode   @default(OAUTH)
  /// Assinatura secreta do webhook DO GRUPO (x-signature), cifrada (AES-GCM v2, AAD proprio). null = sem segredo.
  webhookSecretEnc String?
  /// Ultimos 4 caracteres do access token (so para o Mestre reconhecer qual colou; nunca mais que isso).
  tokenHint        String?
  status           PaymentAccountStatus @default(CONNECTED)
  connectedAt      DateTime?
  connectedById    Int?
  /// Ultimo erro (texto curto, sem token/segredo) da renovacao/uso da conta.
  lastError        String?
  /// Ultimo aviso "a assinatura do webhook nao confere" (no maximo 1 por 24 h por grupo - PLANO_PROJETO.md 10.56, A2).
  signatureAlertAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([provider, providerUserId])
}

/// `state` do OAuth de USO UNICO (PLANO_PROJETO.md 10.53): o nonce assinado no state e gravado aqui no POST /connect e
/// CONSUMIDO atomicamente no callback (usedAt) - reuso/replay do mesmo state e recusado. Linhas vencidas sao apagadas
/// no proprio /connect.
model PaymentOauthState {
  id             Int       @id @default(autoincrement())
  nonce          String    @unique
  organizationId Int
  userId         Int
  provider       String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// Eventos de pagamento recebidos/aplicados (webhook do provedor, sincronizacao sob demanda e reconciliacao): dao a
/// IDEMPOTENCIA (reentrega do mesmo evento nao reprocessa; um pagamento ja aplicado - outcome PAID - nunca baixa de novo,
/// nem depois de um estorno manual) e a trilha de auditoria do que o provedor disse. rawSafe = so campos nao sensiveis.
/// INVARIANTE: eventos com outcome PAID NUNCA podem ser apagados (nenhum job de retencao deve tocar nesta tabela sem
/// excluir PAID): sao eles que impedem um pagamento ja aplicado de baixar de novo depois de um estorno.
model PaymentWebhookEvent {
  id                Int       @id @default(autoincrement())
  provider          String
  /// Id do evento: id da notificacao (webhook) ou `sync:<paymentId>:<status>` (sincronizacao/reconciliacao).
  eventId           String
  paymentId         String?
  organizationId    Int?
  financialRecordId Int?
  /// WEBHOOK | SYNC | RECONCILE
  source            String
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  /// PAID, DUPLICATE, ALREADY_APPLIED, PENDING, CANCELLED, AMOUNT_MISMATCH, PAID_CONFLICT, REFUND_ALERT, IGNORED, ...
  outcome           String?
  rawSafe           Json?
  /// Webhook: true = x-signature conferida com o segredo do grupo (ou o do servidor); false = sem segredo nenhum,
  /// processado so como GATILHO (o pagamento e sempre buscado no provedor). null = consulta/reconciliacao.
  signatureVerified Boolean?
  /// Webhook processado como gatilho porque a assinatura NAO conferiu (10.56, A2): MISSING | MISMATCH | UNREADABLE.
  signatureProblem  String?

  @@unique([provider, eventId])
  @@index([provider, paymentId])
  @@index([organizationId, receivedAt])
}

/// type: categoria livre (BATIZADO/WORKSHOP/CAMPEONATO/FESTIVAL/ENCONTRO/FORMATURA/VIAGEM/
/// AULA_ESPECIAL/OUTRO, projeto.txt §43 — "RODA" fica de fora, esse tipo já tem o model Roda
/// dedicado). String (não enum) de propósito, mesmo espírito de Notification.type/
/// SubscriptionEvent.type: é uma tag de categorização/filtro, não uma regra de negócio.
///
/// stateId/cityId: mesmos campos que Roda já tinha desde a fundação — permitem o Calendário
/// estadual (projeto.txt §42, Fase 2 §10.17) agregar Roda+Event num só feed público filtrável.
model Event {
  id                   Int         @id @default(autoincrement())
  organizationId       Int
  unitId               Int?
  stateId              Int?
  cityId               Int?
  title                String
  type                 String      @default("OUTRO")
  description          String?
  date                 DateTime
  location             String?
  /// Coordenadas do local para o mapa da comunidade (opcionais; ver Unit.latitude).
  latitude             Float?
  longitude            Float?
  isPublic             Boolean     @default(false)
  /// URL de uma imagem de capa (sem upload de arquivo — mesmo padrão leve de Student.photo/
  /// PublicProfile.photo). Usada nos cards do feed (Home/Calendário, PLANO_PROJETO.md §10.21/
  /// §10.22); sem ela, o card usa um placeholder ilustrado com o ícone do tipo.
  imageUrl             String?
  /// Vagas (null = ilimitado). Contam CONFIRMED + ATTENDED; acima disso a inscricao vai para a lista de espera
  /// (ParticipantStatus.WAITLIST) so a pedido do inscrito.
  capacity             Int?
  /// Valor de inscricao em centavos (null/0 = gratuito). INFORMATIVO: nao ha cobranca online nesta versao.
  priceCents           Int?
  /// DRAFT/PUBLISHED/CANCELLED/CLOSED (ver enum EventStatus). Eventos antigos nascem PUBLISHED.
  status               EventStatus @default(PUBLISHED)
  /// Prazo das inscricoes feitas pelo proprio aluno/responsavel (a equipe inscreve a qualquer momento).
  registrationDeadline DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  unit              Unit?              @relation(fields: [unitId], references: [id])
  state             State?             @relation(fields: [stateId], references: [id])
  city              City?              @relation(fields: [cityId], references: [id])
  participants      EventParticipant[]
  registrationForms RegistrationForm[]

  @@index([organizationId, date])
  @@index([stateId, date])
  @@index([cityId, date])
  @@index([latitude, longitude])
}

/// guestName cobre participantes sem cadastro de student/user (ex.: convidado externo em
/// evento aberto) — decisao de modelagem.
model EventParticipant {
  id             Int               @id @default(autoincrement())
  organizationId Int
  eventId        Int
  studentId      Int?
  userId         Int?
  guestName      String?
  status         ParticipantStatus @default(CONFIRMED)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  user         User?        @relation("EventParticipantUser", fields: [userId], references: [id])

  @@index([eventId])
  @@index([organizationId])
}

// =========================================================================
// FORMULARIOS DE INSCRICAO (docs/PLANO_FORMULARIOS_INSCRICAO.md, F1): o Mestre monta o formulario (ligado a um
// Event ou avulso), publica um link publico (/i/<slug>) e qualquer pessoa se inscreve SEM login.
// =========================================================================

/// DRAFT (so a equipe ve; link publico = 404), OPEN (aceita inscricoes), CLOSED (link mostra "encerradas"),
/// ARCHIVED (fora das listas; link publico = 404).
enum RegistrationFormStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/// NONE = gratuito; PIX_MANUAL = chave Pix do grupo + comprovante conferido pelo Mestre; PIX_AUTO = reservado (F2,
/// Mercado Pago): aceito no enum mas a API responde 400 PAYMENT_MODE_NOT_AVAILABLE.
enum RegistrationPaymentMode {
  NONE
  PIX_MANUAL
  PIX_AUTO
}

/// Situacao da inscricao. PENDING e CONFIRMED ocupam vaga (maxSubmissions); WAITLIST/REJECTED/CANCELLED nao.
enum RegistrationSubmissionStatus {
  PENDING
  CONFIRMED
  WAITLIST
  REJECTED
  CANCELLED
}

enum RegistrationPaymentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
}

model RegistrationForm {
  id                  Int                     @id @default(autoincrement())
  organizationId      Int
  /// Evento ligado (opcional). Excluir o evento NAO apaga o formulario (vira avulso).
  eventId             Int?
  /// Unico no GingApp inteiro, curto e legivel (titulo + sufixo aleatorio). Definitivo na 1a publicacao (publishedAt).
  slug                String                  @unique
  title               String
  intro               String?
  /// Mesmo formato de Event.imageUrl (IsImageRef: /api/uploads/<uuid>.<ext> ou URL http(s)).
  bannerUrl           String?
  status              RegistrationFormStatus  @default(DRAFT)
  opensAt             DateTime?
  closesAt            DateTime?
  maxSubmissions      Int?
  allowWaitlist       Boolean                 @default(false)
  paymentMode         RegistrationPaymentMode @default(NONE)
  priceCents          Int?
  pixKey              String?
  /// CPF | CNPJ | EMAIL | PHONE | RANDOM
  pixKeyType          String?
  pixBeneficiary      String?
  /// true = o Mestre aprova cada inscricao; false = confirma sozinha (sem pagamento) ou ao confirmar o pagamento.
  requireApproval     Boolean                 @default(false)
  confirmationMessage String?
  /// Texto de consentimento (LGPD). Vazio = texto padrao do sistema. consentVersion sobe a cada troca do texto.
  consentText         String?
  consentVersion      Int                     @default(1)
  /// Retencao: N meses depois do encerramento (closesAt/evento/fechamento/arquivamento) as respostas e anexos sao
  /// anonimizados/apagados pelo job FORMS_RETENTION_PURGE.
  retentionMonths     Int                     @default(12)
  publishedAt         DateTime?
  closedAt            DateTime?
  archivedAt          DateTime?
  purgedAt            DateTime?
  /// Agrupamento do aviso ao Mestre (no maximo 1 por formulario a cada 5 min, com contador).
  lastNotifiedAt      DateTime?
  pendingNotifyCount  Int                     @default(0)
  createdById         Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  organization    Organization                 @relation(fields: [organizationId], references: [id])
  event           Event?                       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sections        RegistrationFormSection[]
  fields          RegistrationFormField[]
  submissions     RegistrationSubmission[]
  files           RegistrationSubmissionFile[]
  consentVersions RegistrationConsentVersion[]

  @@index([organizationId, status])
  @@index([eventId])
}

/// Snapshot do texto de consentimento EFETIVO (texto do formulario ou o padrao com retentionMonths + rotulos dos campos
/// CONSENT) de cada versao: prova o que a pessoa aceitou (RegistrationSubmission.consentVersion aponta para cá).
/// Nova linha a cada mudanca do texto efetivo (SHA-256 diferente). Sem dado pessoal.
model RegistrationConsentVersion {
  id        Int      @id @default(autoincrement())
  formId    Int
  version   Int
  textHash  String
  text      String
  createdAt DateTime @default(now())

  form RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, version])
}

model RegistrationFormSection {
  id          Int      @id @default(autoincrement())
  formId      Int
  order       Int
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form   RegistrationForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields RegistrationFormField[]

  @@index([formId, order])
}

/// Campo do formulario. `key` e ESTAVEL (as respostas sao guardadas por ela) e unica no formulario. Campo removido
/// de um formulario que ja tem inscricoes vira `archived` (as respostas antigas continuam legiveis).
/// type: SHORT_TEXT | LONG_TEXT | NUMBER | EMAIL | PHONE | CPF | DATE | SINGLE_CHOICE | MULTI_CHOICE | SELECT | CONSENT |
/// FILE | INFO. mapsTo: name | nickname | birthDate | document | phone | email | city | group | teacher | cord.
model RegistrationFormField {
  id         Int      @id @default(autoincrement())
  formId     Int
  sectionId  Int?
  key        String
  order      Int
  type       String
  label      String
  helpText   String?
  required   Boolean  @default(false)
  options    Json?
  validation Json?
  /// { fieldKey, equals } | null - reavaliado no servidor.
  showIf     Json?
  mapsTo     String?
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  form    RegistrationForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  section RegistrationFormSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([formId, key])
  @@index([formId, order])
}

/// Inscricao (anonima). answers = { fieldKey: valor } SEM o CPF de identificacao (documentHash/documentEnc, helper da
/// ficha unica), sem o e-mail e o telefone de identificacao (colunas proprias). Outros campos CPF ficam cifrados.
/// ipHash = HMAC do IP com segredo do servidor (nunca o IP cru). Depois da retencao: anonymizedAt e PII apagada.
model RegistrationSubmission {
  id                 Int                          @id @default(autoincrement())
  organizationId     Int
  formId             Int
  /// INS-XXXXXX (alfabeto sem caracteres ambiguos).
  protocol           String                       @unique
  status             RegistrationSubmissionStatus @default(PENDING)
  paymentStatus      RegistrationPaymentStatus    @default(NOT_REQUIRED)
  answers            Json
  name               String
  email              String?
  /// E-mail normalizado SO para duplicidade e limite de avisos (minusculas, sem "+tag"; gmail/googlemail sem pontos).
  emailKey           String?
  phone              String?
  documentHash       String?
  documentEnc        String?
  documentLast4      String?
  consentAt          DateTime
  consentVersion     Int
  ipHash             String?
  userAgent          String?
  /// Participante do evento criado/ligado ao CONFIRMAR (sem FK: o participante pode ser removido no evento).
  eventParticipantId Int?
  personId           Int?
  /// Aluno ligado (so por acao do MESTRE: linkStudentId em approve/confirm-payment). O envio anonimo NUNCA liga.
  studentId          Int?
  /// Aluno ATIVO do grupo com o mesmo CPF (sugestao para o Mestre confirmar; nunca vinculo automatico).
  suggestedStudentId Int?
  reviewedById       Int?
  reviewedAt         DateTime?
  reviewNote         String?
  internalNote       String?
  anonymizedAt       DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id])
  form         RegistrationForm             @relation(fields: [formId], references: [id])
  files        RegistrationSubmissionFile[]

  @@index([formId, status])
  @@index([formId, createdAt])
  @@index([formId, documentHash])
  @@index([formId, email])
  @@index([formId, emailKey])
  @@index([emailKey, createdAt])
  @@index([formId, ipHash, createdAt])
  @@index([organizationId])
}

/// Anexo PRIVADO (comprovante/documento): fica em PRIVATE_UPLOADS_DIR (nunca em /api/uploads), nome aleatorio,
/// tipo pelos magic bytes. Enviado ANTES da inscricao (anonimo): pendingToken = SHA-256 do token devolvido ao
/// navegador + expiresAt (2 h); ao enviar a inscricao o arquivo e ligado (submissionId) e o token some.
model RegistrationSubmissionFile {
  id             Int       @id @default(autoincrement())
  submissionId   Int?
  formId         Int
  organizationId Int
  fieldKey       String
  /// Caminho RELATIVO no armazenamento privado (org-<id>/<uuid>.<ext>).
  storageKey     String    @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  pendingToken   String?   @unique
  expiresAt      DateTime?
  /// HMAC do IP de quem enviou o anexo pendente (IPv6 agrupado por /64): teto de pendentes por IP+formulario.
  ipHash         String?
  createdAt      DateTime  @default(now())

  submission   RegistrationSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  form         RegistrationForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  organization Organization            @relation(fields: [organizationId], references: [id])

  @@index([submissionId])
  @@index([formId, expiresAt])
  @@index([formId, ipHash])
  @@index([organizationId, submissionId])
}

/// Comunicados internos do grupo, com escopo opcional por unidade (projeto.txt §47).
model Announcement {
  id              Int                 @id @default(autoincrement())
  organizationId  Int
  unitId          Int?
  title           String
  body            String
  publishedAt     DateTime?
  isActive        Boolean             @default(true)
  /// Alcance adicional (todos opcionais; se combinam por E): so alunos matriculados (ClassStudent ACTIVE) nesta turma
  /// e seus responsaveis; so quem pertence a unidades da UF (Unit.state); so um papel do grupo (ALUNO, RESPONSAVEL...).
  classId         Int?
  stateUf         String?
  audienceRole    OrgRole?
  createdByUserId Int
  /// --- Comunicar (contrato §3). Tudo com padrao: o aviso rapido e o /announcements legados continuam iguais. ---
  /// SENT (padrao/legado), SCHEDULED (aguarda o agendador) ou CANCELLED. `publishedAt` e o instante do envio
  /// (nulo enquanto SCHEDULED); `unitId`/`classId` sao o alcance UNIT/CLASS; `createdByUserId` e o autor.
  status          CommunicationStatus @default(SENT)
  /// Tipo de alcance escolhido no Comunicar (nulo nos avisos legados, que usam unitId/classId/stateUf/audienceRole).
  scopeType       CommunicationScope?
  /// Alcance ROLE: ALUNO | RESPONSAVEL | EQUIPE (EQUIPE nao existe em OrgRole, por isso texto e nao `audienceRole`).
  scopeRole       String?
  scheduledAt     DateTime?
  requiresAck     AckRequirement      @default(NONE)
  pinToFeed       Boolean             @default(false)
  pinnedUntil     DateTime?
  /// Mesmo formato de Event.imageUrl (IsImageRef: /api/uploads/<uuid>.<ext> ou URL http(s)).
  imageUrl        String?
  recipientsCount Int                 @default(0)
  lastResendAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id])
  unit          Unit?             @relation(fields: [unitId], references: [id])
  class         Class?            @relation(fields: [classId], references: [id])
  createdByUser User              @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  acks          AnnouncementAck[]
  notifications Notification[]

  @@index([organizationId, publishedAt])
  // Agendador (SCHEDULED vencidos) e listagem por status.
  @@index([status, scheduledAt])
  @@index([organizationId, status, createdAt])
  // Fixados no feed vigentes.
  @@index([organizationId, pinToFeed, status])
}

/// Confirmacao de um comunicado pelo destinatario (Li / Vou / Nao vou). Uma por usuario; pode trocar GOING<->NOT_GOING.
model AnnouncementAck {
  id             Int         @id @default(autoincrement())
  organizationId Int
  announcementId Int
  userId         Int
  response       AckResponse
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementAckUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([organizationId, userId])
}

enum CommunicationStatus {
  SENT
  SCHEDULED
  CANCELLED
}

enum CommunicationScope {
  GROUP
  UNIT
  CLASS
  ROLE
  BIRTHDAY_MONTH
}

enum AckRequirement {
  NONE
  READ
  GOING
}

enum AckResponse {
  READ
  GOING
  NOT_GOING
}

/// --- Aniversariantes (contrato §2) ---
enum BirthdayGreetingSource {
  MANUAL
  AUTO
}

/// Parabens enviado PELO GRUPO (equipe no painel = MANUAL, job = AUTO) a uma pessoa em um ano. Unico por pessoa+ano+origem
/// (idempotencia do job e de "ja parabenizado este ano").
model BirthdayGreeting {
  id             Int                    @id @default(autoincrement())
  organizationId Int
  personId       Int
  year           Int
  source         BirthdayGreetingSource
  greeterUserId  Int?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  greeter      User?        @relation("BirthdayGreetingGreeter", fields: [greeterUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, personId, year, source])
  @@index([organizationId, year])
}

/// Parabens de um colega (app) a um aniversariante. Um por (aniversariante, quem deu, ano).
model BirthdayCongrats {
  id             Int      @id @default(autoincrement())
  organizationId Int
  personId       Int
  giverUserId    Int
  year           Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  giver        User         @relation("BirthdayCongratsGiver", fields: [giverUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId, giverUserId, year])
  @@index([organizationId, giverUserId, year])
}

/// --- Feed do grupo (contrato §4) ---
enum FeedPostingMode {
  ALL
  STAFF_ONLY
  MODERATED
}

enum FeedVisibility {
  GROUP
  UNIT
  CLASS
}

enum FeedPostStatus {
  PUBLISHED
  PENDING_APPROVAL
  HIDDEN
  REMOVED
}

enum FeedCommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

/// POST = publicacao do feed; STORY = foto + legenda curta que expira (FeedPost.expiresAt), sem reacao nem comentario.
enum FeedPostKind {
  POST
  STORY
}

enum FeedReactionType {
  AXE
  SALVE
  GINGA
  PARABENS
  CORACAO
}

enum FeedReportReason {
  OFENSIVO
  IMPROPRIO
  SPAM
  MENOR
  OUTRO
}

enum FeedReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// Post do feed. `authorUserId`/`authorPersonId` ficam nulos ao anonimizar (LGPD; body tambem vira nulo e a midia e apagada).
/// REMOVED = apagado pelo autor/moderador (soft delete: `deletedAt`), nunca listado.
model FeedPost {
  id             Int            @id @default(autoincrement())
  organizationId Int
  authorUserId   Int?
  authorPersonId Int?
  body           String?
  visibility     FeedVisibility @default(GROUP)
  unitId         Int?
  classId        Int?
  status         FeedPostStatus @default(PUBLISHED)
  /// POST (padrao) ou STORY (so foto + legenda curta em `body`; expira em `expiresAt`).
  kind           FeedPostKind   @default(POST)
  /// So stories: instante em que deixam de ser exibidos (a limpeza do cron marca REMOVED e apaga a foto 1 h depois).
  expiresAt      DateTime?
  pinned         Boolean        @default(false)
  edited         Boolean        @default(false)
  /// Motivo curto da ocultacao (ex.: 'REPORTS', 'MODERATOR'); nunca mostrado com culpa ao autor.
  hiddenReason   String?
  /// Quem ocultou/recusou (nulo = ocultacao automatica por denuncias). Sem FK: so referencia para a hierarquia da moderacao.
  hiddenById     Int?
  approvedById   Int?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization    Organization         @relation(fields: [organizationId], references: [id])
  author          User?                @relation("FeedPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorPerson    Person?              @relation(fields: [authorPersonId], references: [id], onDelete: SetNull)
  approvedBy      User?                @relation("FeedPostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  unit            Unit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  class           Class?               @relation(fields: [classId], references: [id], onDelete: Restrict)
  media           FeedPostMedia[]
  reactions       FeedReaction[]
  comments        FeedComment[]
  reports         FeedReport[]
  activityNotices FeedActivityNotice[]
  storyViews      FeedStoryView[]

  @@index([organizationId, status, pinned, createdAt(sort: Desc)])
  @@index([organizationId, kind, status, expiresAt])
  @@index([organizationId, unitId])
  @@index([organizationId, classId])
  @@index([authorUserId])
}

/// Foto do post. Enviada antes (postId nulo = pendente, com `pendingExpiresAt`, limpa pelo job) e vinculada ao criar o post.
/// Arquivos em armazenamento PRIVADO (FEED_MEDIA_DIR); `storageKey`/`thumbKey` sao nomes de arquivo, nunca URL.
model FeedPostMedia {
  id               Int       @id @default(autoincrement())
  organizationId   Int
  postId           Int?
  uploaderUserId   Int?
  storageKey       String    @unique
  thumbKey         String    @unique
  width            Int
  height           Int
  sizeBytes        Int
  mimeType         String
  order            Int       @default(0)
  pendingExpiresAt DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  post         FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader     User?        @relation("FeedMediaUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([postId, order])
  @@index([pendingExpiresAt])
  @@index([organizationId, uploaderUserId])
}

/// Uma reacao por usuario por post (trocar de tipo = update).
model FeedReaction {
  id        Int              @id @default(autoincrement())
  postId    Int
  userId    Int
  type      FeedReactionType
  createdAt DateTime         @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

/// Story visto por um usuario (um registro por usuario por story; idempotente). Some com o story (cascade) e com o usuario.
model FeedStoryView {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation("FeedStoryViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

/// Comentario (um nivel de resposta via parentId). Anonimizado = authorUserId/body nulos.
model FeedComment {
  id             Int               @id @default(autoincrement())
  organizationId Int
  postId         Int
  parentId       Int?
  authorUserId   Int?
  body           String?
  status         FeedCommentStatus @default(PUBLISHED)
  /// Quem ocultou (nulo = ocultacao automatica por denuncias). Sem FK.
  hiddenById     Int?
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  post         FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      FeedComment[] @relation("FeedCommentReplies")
  author       User?         @relation("FeedCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  reports      FeedReport[]

  @@index([postId, createdAt])
  @@index([authorUserId])
}

/// Denuncia de post OU de comentario (exatamente um dos dois). Os unicos [reporter,postId] e [reporter,commentId] sao
/// constraints simples: no Postgres NULL nao colide com NULL, entao cada alvo e unico por denunciante.
model FeedReport {
  id             Int              @id @default(autoincrement())
  organizationId Int
  postId         Int?
  commentId      Int?
  reporterUserId Int?
  reason         FeedReportReason
  note           String?
  status         FeedReportStatus @default(OPEN)
  resolvedById   Int?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  post         FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter     User?        @relation("FeedReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("FeedReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterUserId, postId])
  @@unique([reporterUserId, commentId])
  @@index([organizationId, status, createdAt])
  @@index([postId])
  @@index([commentId])
}

/// Agrupamento das notificacoes de atividade (reacao/comentario) de um post por janela de 30 min: UMA Notification
/// por (post, autor do post); `count` cresce dentro da janela; fora dela abre-se nova janela (nova Notification).
model FeedActivityNotice {
  id              Int      @id @default(autoincrement())
  postId          Int
  authorUserId    Int
  windowStartedAt DateTime
  count           Int      @default(1)
  /// Ultimo usuario que reagiu/comentou (para "Fulano e mais N"); sem FK.
  lastActorUserId Int?
  notificationId  Int?

  post         FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([postId, authorUserId])
  @@index([windowStartedAt])
}

/// Modelo de AVISO RAPIDO (FAB do painel): texto pronto que o MESTRE cadastra para a equipe usar com 1 toque.
/// So' title/body/emoji + ordem (sem audiencia padrao: o alcance e' escolhido no envio). Os modelos PADRAO do sistema
/// (builtin) NAO ficam no banco: sao devolvidos junto na listagem. `createdById` e' so' informativo (sem FK).
/// Apagar e' DELETE de verdade (o modelo nao e' dado de negocio; as notificacoes ja enviadas nao referenciam o modelo).
model QuickNoticeTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int
  title          String
  body           String
  emoji          String?
  sortOrder      Int      @default(0)
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
}

model Notification {
  id             Int       @id @default(autoincrement())
  organizationId Int?
  userId         Int
  title          String
  body           String
  type           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  /// Carga extra para o app (contrato: `data.communicationId`, `data.postId`...). Nulo nas notificacoes antigas.
  data           Json?
  /// Liga a notificacao ao comunicado que a gerou: "lidos" = count(readAt != null) por announcementId.
  announcementId Int?

  organization        Organization?        @relation(fields: [organizationId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  announcement        Announcement?        @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  feedActivityNotices FeedActivityNotice[]

  @@index([userId, createdAt])
  @@index([announcementId, readAt])
}

/// Web Push (I13): um dispositivo/navegador inscrito para receber avisos no celular. OPCIONAL: so' usado quando
/// VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT estao configuradas. `endpoint` e' unico no mundo (identifica a
/// inscricao do navegador); reinscrever o mesmo endpoint e' idempotente. Apagada em 404/410 do servico de push.
model PushSubscription {
  id             Int       @id @default(autoincrement())
  userId         Int
  organizationId Int?
  /// Web Push (VAPID): endpoint + chaves. Nulos nas linhas provider='fcm' (so' o token).
  endpoint       String?   @unique
  p256dh         String?
  auth           String?
  /// 'webpush' (VAPID, lib web-push) ou 'fcm' (Firebase Cloud Messaging).
  provider       String    @default("webpush")
  /// FCM registration token (provider='fcm'); unico no sistema.
  token          String?   @unique
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Quais categorias de aviso o usuario quer receber como push (a notificacao in-app e' sempre gravada).
/// Sem linha = tudo ligado.
model PushPreference {
  userId        Int      @id
  lessons       Boolean  @default(true)
  finance       Boolean  @default(true)
  events        Boolean  @default(true)
  graduations   Boolean  @default(true)
  announcements Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================================
// COMUNIDADE (publica / compartilhavel)
// =========================================================================

model State {
  id        Int      @id @default(autoincrement())
  name      String
  uf        String   @unique
  createdAt DateTime @default(now())

  cities      City[]
  communities Community[]
  rodas       Roda[]
  events      Event[]
}

model City {
  id        Int      @id @default(autoincrement())
  stateId   Int
  name      String
  createdAt DateTime @default(now())

  state  State   @relation(fields: [stateId], references: [id])
  rodas  Roda[]
  events Event[]

  @@index([stateId])
}

model Community {
  id          Int      @id @default(autoincrement())
  stateId     Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  state State  @relation(fields: [stateId], references: [id])
  rodas Roda[]

  @@index([stateId])
}

/// organizationId (opcional): identifica qual grupo organiza a roda, para permitir edição/
/// exclusão restrita a quem criou. Nullable porque uma roda pode, no futuro, ser publicada
/// por um perfil independente sem organização — mas hoje toda criação parte de um usuário
/// MEMBER autenticado, então sempre virá preenchido na prática (PLANO_PROJETO.md §10.7,
/// gap identificado: o schema original não tinha essa FK e não dava para restringir quem
/// pode editar/apagar uma roda de outro grupo).
model Roda {
  id              Int            @id @default(autoincrement())
  organizationId  Int?
  communityId     Int?
  stateId         Int?
  cityId          Int?
  title           String
  description     String?
  date            DateTime
  location        String?
  /// Coordenadas do local para o mapa da comunidade (opcionais; ver Unit.latitude).
  latitude        Float?
  longitude       Float?
  /// Mesma convenção de Event.imageUrl acima — URL de capa opcional, sem upload de arquivo.
  imageUrl        String?
  /// Recorrencia ("roda mensal"): a roda MAE guarda a regra (derivada de `date`: dia da semana, n-esimo dia da
  /// semana do mes ou dia do mes) e POST /rodas/:id/generate-occurrences cria as proximas ocorrencias como rodas
  /// filhas (parentRodaId), de forma idempotente. As filhas tem recurrence NONE.
  recurrence      RodaRecurrence @default(NONE)
  /// Ultimo dia (inclusive) em que a serie pode gerar ocorrencias; null = sem fim.
  recurrenceUntil DateTime?
  parentRodaId    Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id])
  community    Community?        @relation(fields: [communityId], references: [id])
  state        State?            @relation(fields: [stateId], references: [id])
  city         City?             @relation(fields: [cityId], references: [id])
  parent       Roda?             @relation("RodaOccurrences", fields: [parentRodaId], references: [id], onDelete: SetNull)
  occurrences  Roda[]            @relation("RodaOccurrences")
  participants RodaParticipant[]

  @@unique([parentRodaId, date])
  @@index([organizationId])
  @@index([stateId, date])
  @@index([cityId, date])
  @@index([latitude, longitude])
}

model RodaParticipant {
  id        Int               @id @default(autoincrement())
  rodaId    Int
  userId    Int?
  studentId Int?
  guestName String?
  status    ParticipantStatus @default(CONFIRMED)
  createdAt DateTime          @default(now())

  roda    Roda     @relation(fields: [rodaId], references: [id])
  user    User?    @relation("RodaParticipantUser", fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([rodaId])
}

/// Perfil publico opt-in (projeto.txt §17/§53). Para menores, exige consentByGuardianId
/// preenchido — nunca opt-in automatico (PLANO_PROJETO.md §3.4). Nenhum dado privado
/// (students, financial_records, student_guardians) e exposto aqui alem do essencial.
///
/// publicCode: token publico nao-sequencial (mesmo espirito de Certificate.verificationCode,
/// Fase 2 §10.15) — a URL/QR do Passaporte do Capoeirista aponta pra esse codigo, nunca pro
/// `id` (PLANO_PROJETO.md §10.16).
model PublicProfile {
  id                  Int      @id @default(autoincrement())
  organizationId      Int?
  userId              Int?     @unique
  studentId           Int?     @unique
  displayName         String
  bio                 String?
  photo               String?
  consentByGuardianId Int?
  isPublished         Boolean  @default(false)
  publicCode          String   @unique @default(cuid())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization?    @relation(fields: [organizationId], references: [id])
  user              User?            @relation("PublicProfileUser", fields: [userId], references: [id])
  student           Student?         @relation("PublicProfileStudent", fields: [studentId], references: [id])
  consentByGuardian StudentGuardian? @relation("PublicProfileGuardianConsent", fields: [consentByGuardianId], references: [id])

  @@index([organizationId])
}

/// Modelo simples (Certificate e Fase 2 no roadmap, PLANO_PROJETO.md §7) — presente desde
/// ja no schema apenas para nao exigir migration nova quando a feature for implementada.
/// verificationCode: token público não-sequencial (projeto.txt §52: "QR Code poderá validar a
/// autenticidade") — o QR aponta para uma URL pública com esse código, nunca com o `id`
/// (sequencial, enumerável). Ver Fase 2, PLANO_PROJETO.md §10.15.
model Certificate {
  id                  Int       @id @default(autoincrement())
  organizationId      Int
  studentId           Int
  studentGraduationId Int?
  title               String
  issuedAt            DateTime?
  fileUrl             String?
  verificationCode    String    @unique @default(cuid())
  createdAt           DateTime  @default(now())
  /// Modelo usado na emissao (docs/CONTRATO_CERTIFICADOS_MODELOS.md secao 7); null = classico embutido ou modelo excluido.
  templateId          Int?
  /// COPIA do desenho (CertificateLayout) no momento da emissao, com o logo do grupo ja resolvido. Editar/excluir o
  /// modelo NAO muda o certificado emitido. null = certificado antigo (renderiza o classico embutido).
  layoutSnapshot      Json?

  organization      Organization         @relation(fields: [organizationId], references: [id])
  student           Student              @relation(fields: [studentId], references: [id])
  studentGraduation StudentGraduation?   @relation(fields: [studentGraduationId], references: [id])
  template          CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([studentId])
  @@index([templateId])
}

/// Uso do modelo de certificado (contrato secao 5): define o padrao por (grupo, uso).
enum CertificatePurpose {
  GRADUACAO
  BATIZADO
  EVENTO
  PARTICIPACAO
  OUTRO
}

/// Modelo de certificado do GRUPO (docs/CONTRATO_CERTIFICADOS_MODELOS.md): desenho em JSON (CertificateLayout v1, validado
/// em src/interface/http/certificates/certificate-layout.ts). No maximo 1 padrao por (grupo, uso): indice unico PARCIAL
/// ("organizationId", "purpose") WHERE "isDefault", criado na migration 20261103000000_certificate_templates (o Prisma nao
/// declara indice parcial no schema). Exclusao REAL; os certificados emitidos seguem pelo layoutSnapshot.
model CertificateTemplate {
  id              Int                @id @default(autoincrement())
  organizationId  Int
  name            String
  purpose         CertificatePurpose
  isDefault       Boolean            @default(false)
  layout          Json
  /// So informativo (sem FK), como QuickNoticeTemplate.createdById.
  createdByUserId Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@index([organizationId, purpose])
}

// =========================================================================
// GINGA RANK (ranking de alunos e grupos)
// =========================================================================

/// Tipo de ponto do Ginga Rank. Os valores e as regras ficam em src/interface/http/ranking/ranking-rules.ts (SSOT).
/// Mensalidade/financeiro NUNCA gera ponto.
enum PointEventType {
  CLASS_ATTENDANCE
  STREAK_BONUS
  EVENT_ATTENDANCE
  RODA_PARTICIPATION
  MONTHLY_CONSISTENCY
  GRADUATION
  CERTIFICATE
}

/// Ponto ganho por um aluno, DERIVADO das tabelas de origem (presenca, evento, roda, graduacao, certificado) por
/// RankingService.syncStudent (idempotente: upsert pela chave unica + remocao do que deixou de existir na origem).
/// refType/refId identificam a origem (ex.: 'Lesson'/'123', 'Week'/'2026-10-05', 'Month'/'2026-09'). season = 'YYYY-MM'
/// (mes do ponto; data civil UTC para aula/graduacao, America/Sao_Paulo para instantes).
model PointEvent {
  id             Int            @id @default(autoincrement())
  organizationId Int
  studentId      Int
  type           PointEventType
  points         Int
  refType        String
  refId          String
  occurredAt     DateTime
  season         String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, type, refType, refId])
  @@index([season, organizationId])
  @@index([studentId, season])
}

/// Preferencias do aluno no ranking. Sem linha = opt-in desligado e sem apelido. optInPublic liga a aparicao nos
/// rankings ABERTOS (cidade/estado/Brasil); menor de idade so aparece la com o consentimento do responsavel
/// (StudentGuardian.consentPublicProfile, o MESMO consentimento do Passaporte). No ranking do proprio grupo todos
/// os alunos ATIVOS aparecem sempre.
model RankingProfile {
  id          Int      @id @default(autoincrement())
  studentId   Int      @unique
  optInPublic Boolean  @default(false)
  nickname    String?
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

/// Conquista do aluno (codigos em ranking-rules.ts). Codigos 'LEAGUE_*' sao marcadores internos de "liga ja
/// notificada" (nao aparecem como conquista), para nunca notificar a mesma liga duas vezes.
model Achievement {
  id        Int      @id @default(autoincrement())
  studentId Int
  code      String
  earnedAt  DateTime
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
}

/// Resultado de uma temporada FECHADA (snapshot dos top 10). scope: GROUP (scopeKey = id do grupo; alunos do grupo),
/// COUNTRY (scopeKey 'BR'; alunos com opt-in) ou GROUPS_COUNTRY (scopeKey 'BR'; grupos, points = media por aluno).
/// Sem FK de proposito: e' historico imutavel. Idempotente: o fechamento pula (season, scope, scopeKey) ja gravado.
model SeasonResult {
  id             Int      @id @default(autoincrement())
  season         String
  scope          String
  scopeKey       String
  rank           Int
  studentId      Int?
  organizationId Int?
  points         Int
  createdAt      DateTime @default(now())

  @@unique([season, scope, scopeKey, rank])
  @@index([season])
}
