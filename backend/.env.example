# PostgreSQL (Prisma)
# Via docker-compose (dev): o backend roda dentro do compose, use o hostname do serviço.
#   DATABASE_URL="postgresql://gingapp:gingapp@postgres:5432/gingapp?schema=public"
# Rodando o backend nativamente (fora do Docker) contra o Postgres do docker-compose
# (exposto em 15432 — esta máquina já tem outros Postgres em 5432/5433/55432 de outros projetos):
DATABASE_URL="postgresql://gingapp:gingapp@localhost:15432/gingapp?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Allowlist de IP para POST /api/auth/platform-login (opcional).
# Lista separada por virgula. Se vazio/ausente, nenhuma restricao de IP e aplicada.
PLATFORM_ALLOWED_IPS=

# Porta HTTP do backend
PORT=3000

# Job diario de mensalidade vencida (03:00 America/Sao_Paulo). OVERDUE_CRON=false desliga (os testes e2e ja rodam com false).
OVERDUE_CRON=true
# true = o servidor tambem barra (403 TERMS_NOT_ACCEPTED) quem nao aceitou a versao vigente dos Termos/Politica.
# Padrao false: so o frontend exige o aceite (seed/demo/e2e continuam funcionando).
TERMS_ENFORCEMENT=false

# Imagens enviadas por POST /uploads (foto de aluno, logo, capas): gravadas em disco, sem servico externo.
# Padrao ./uploads (fica fora do git). Em Docker/Easypanel: /app/uploads (volume gingapp_uploads).
UPLOADS_DIR=./uploads
# Cota de imagens por grupo em MB (padrao 1024; 0 = sem limite) e envios por minuto por usuario/IP (padrao 20).
UPLOAD_ORG_QUOTA_MB=1024
UPLOAD_THROTTLE_LIMIT=20

# Formularios de inscricao publicos (docs/PLANO_FORMULARIOS_INSCRICAO.md): comprovantes enviados SEM login ficam num
# diretorio PRIVADO, nunca servido por /api/uploads (so pelo painel, autenticado). Vazio = irmao de UPLOADS_DIR chamado
# "private-uploads" (./private-uploads em dev, fora do git). O backend NAO sobe se ficar dentro de UPLOADS_DIR.
# Docker/Easypanel: /app/private-uploads (volume gingapp_private_uploads).
PRIVATE_UPLOADS_DIR=
# Limite por anexo em MB (padrao 5; maximo 9 = abaixo do client_max_body_size 10m do nginx do app; JPG/PNG/WEBP/PDF
# pelos magic bytes; imagens regravadas sem EXIF/GPS). Tetos de anexos PENDENTES (sem inscricao, contando os expirados
# ainda nao apagados): por formulario (200), por IP+formulario (10; IPv6 por /64) e MB por grupo (500). Acima = 429.
FORMS_FILE_MAX_MB=5
FORMS_PENDING_FILES_MAX=200
FORMS_PENDING_FILES_PER_IP=10
FORMS_PENDING_BYTES_MAX_MB=500
# Inscricoes por IP+formulario (padroes 5/hora e 20/dia; academia que inscreve muitos alunos da mesma rede pode subir),
# teto da lista de espera (200, ou as vagas se menor) e avisos por e-mail disparados por envio ANONIMO: por endereco em
# 24 h (3) e por formulario/hora (100).
FORMS_SUBMISSIONS_PER_IP_HOUR=5
FORMS_SUBMISSIONS_PER_IP_DAY=20
FORMS_WAITLIST_MAX=200
FORMS_MAIL_PER_RECIPIENT_DAILY=3
FORMS_MAIL_FORM_HOURLY_MAX=100
# Transicao do app: true (padrao) ainda aceita o app ANTIGO em cache (startedAt do navegador sem startedToken e envio
# sem consentVersion). Mude para false depois que o app novo estiver no ar.
FORMS_PUBLIC_LEGACY=true
# Retencao (job diario 04:45): anonimiza respostas e apaga anexos N meses (por formulario, padrao 12) depois do
# encerramento (formulario sem data de encerramento: N meses depois de cada envio). dry-run (PADRAO) = so registra no
# log (o backend avisa no boot e o painel mostra o aviso); true = executa; false = desliga os jobs (inclui a limpeza dos
# anexos pendentes expirados, a cada 15 min, que roda em dry-run e true, e a varredura semanal disco x banco).
FORMS_RETENTION_PURGE=dry-run
# Limites por IP por minuto das rotas publicas (padroes): leitura 60, preview 120, anexo 10, envio 10, consulta 5.
# FORMS_READ_THROTTLE_LIMIT / FORMS_SHARE_THROTTLE_LIMIT / FORMS_UPLOAD_THROTTLE_LIMIT / FORMS_SUBMIT_THROTTLE_LIMIT /
# FORMS_LOOKUP_THROTTLE_LIMIT (exportar CSV no painel: FORMS_EXPORT_THROTTLE_LIMIT, padrao 20).

# Feed do grupo (docs/CONTRATO_FEED_ANIVERSARIOS_COMUNICACAO.md secao 4). Fotos em armazenamento PRIVADO: FEED_MEDIA_DIR
# vazio = <PRIVATE_UPLOADS_DIR>/feed (Docker/Easypanel: /app/private-uploads/feed, no volume persistente
# gingapp_private_uploads). O backend NAO sobe se ficar dentro de UPLOADS_DIR ou for igual a PRIVATE_UPLOADS_DIR. Nunca
# servidas por /api/uploads: so por GET /api/feed/media/:id com URL assinada (HMAC do JWT_SECRET) valida por
# FEED_MEDIA_URL_TTL_HOURS (padrao 6; 1..168; foto ainda nao aprovada: so URL curta de 30 min). Cotas diarias (dia
# civil SP): posts (10) e comentarios (60) por usuario. FEED_MEDIA_CLEANUP=false desliga a limpeza a cada 15 min das
# fotos pendentes vencidas (24 h) e de posts removidos + a varredura diaria disco x banco (padrao: ligada).
FEED_MEDIA_DIR=
FEED_MEDIA_URL_TTL_HOURS=6
FEED_POSTS_PER_DAY=10
FEED_COMMENTS_PER_DAY=60
FEED_MEDIA_CLEANUP=true
# Stories do feed (contrato secao 9): FEED_STORY_TTL_HOURS = validade do story em horas (padrao 24; numero fora de 1..48 e
# limitado a esse intervalo; invalido = 24); FEED_STORIES_PER_DAY = cota de stories por usuario por dia civil SP (padrao 5;
# nao conta nos posts). O mesmo FEED_MEDIA_CLEANUP marca REMOVED e apaga a foto dos stories vencidos ha mais de 1 h.
FEED_STORY_TTL_HOURS=24
FEED_STORIES_PER_DAY=5
# Aniversariantes (docs/EASYPANEL.md secao 28): BIRTHDAY_CRON=false desliga o resumo diario 07:30 SP aos gestores e os
# parabens automaticos (varredura de hora em hora). Comunicar: COMM_SCHEDULER=false desliga o envio dos agendados (1 min);
# cotas por dia civil SP: COMM_DAILY_LIMIT_ORG (30 por grupo) e COMM_DAILY_LIMIT_AUTHOR (15 por autor).
BIRTHDAY_CRON=true
COMM_SCHEDULER=true
COMM_DAILY_LIMIT_ORG=30
COMM_DAILY_LIMIT_AUTHOR=15
# Avancado (padroes no codigo, so mude se precisar): fotos por dia por membro/equipe (FEED_MEDIA_USER_PER_DAY=20 /
# FEED_MEDIA_STAFF_PER_DAY=60), pendentes por usuario (FEED_MEDIA_USER_PENDING_MAX=12), por grupo
# (FEED_MEDIA_ORG_PENDING_MAX=200, FEED_MEDIA_ORG_PER_DAY=500); escritas por minuto por usuario/IP
# (FEED_WRITE_THROTTLE_LIMIT=30 / FEED_WRITE_IP_THROTTLE_LIMIT=300), envio de foto (FEED_UPLOAD_THROTTLE_LIMIT=20 /
# FEED_UPLOAD_IP_THROTTLE_LIMIT=120) e leitura de fotos por IP (FEED_MEDIA_READ_THROTTLE_LIMIT=3000).

# E-mail transacional OPCIONAL (E05): "Esqueci minha senha" + convite por e-mail. Sem SMTP_HOST fica desligado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Web Push OPCIONAL (I13): avisos no celular. Sem as 3 variaveis fica desligado. Gere com `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Firebase Cloud Messaging (FCM) OPCIONAL: transporte principal dos avisos push (app aberto e fechado). Precisa das DUAS
# metades (conta de servico + app Web); faltando qualquer uma fica desligado e o Web Push VAPID acima assume.
# Passo a passo no console Firebase: docs/EASYPANEL.md, secao 13b. A chave privada e' segredo (nunca commite).
# Conta de servico: FIREBASE_PRIVATE_KEY aceita \n escapado; FIREBASE_SERVICE_ACCOUNT_JSON (json em base64) substitui os 3.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Config do SDK web (servida ao app em runtime por GET /api/push/config; nada em VITE_*):
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
# Mapa da comunidade OPCIONAL (Google Maps). Sem GOOGLE_MAPS_API_KEY o app mostra lista no lugar do mapa.
# API_KEY = chave de NAVEGADOR (referrer); SERVER_KEY = chave de SERVIDOR so para geocodificar enderecos (nunca vai ao
# navegador; vazia = nao geocodifica); MAP_ID = ID de mapa estilizado (opcional). Ver docs/EASYPANEL.md, secao 14.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
# Origens dos frontends para os links dos e-mails e o QR do certificado PDF.
APP_URL=http://localhost:4173
PAINEL_URL=http://localhost:4174
ADMIN_URL=http://localhost:4175

# Manutencao semanal (domingo de madrugada, America/Sao_Paulo; os testes e2e rodam com tudo desligado):
# AUDIT_RETENTION_DAYS = dias de retencao da trilha de auditoria (padrao 365; 0 = nunca apagar);
# AUDIT_RETENTION_CRON=false desliga o job. UPLOADS_GC=false desliga a limpeza de imagens orfas
# (enviadas e nao usadas por nenhum campo ha mais de 24 h); UPLOADS_GC=dry-run so registra no log o que apagaria.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON=true
UPLOADS_GC=true

# Ginga Rank (ranking de alunos e grupos): RANKING_CRON=false desliga o recalculo noturno (02:30) e o fechamento mensal da
# temporada (dia 1, 03:00; America/Sao_Paulo) - os testes e2e ja rodam com false. RANKING_BACKFILL (so no boot do Docker, ou
# `npm run ranking:backfill` manual): vazio = deriva os pontos do historico UMA vez (tabela vazia); true = sempre; false = nunca.
RANKING_CRON=true
RANKING_BACKFILL=

# Aulas continuas (turma com horario fixo semanal nao precisa de data final): o job diario (01:30, America/Sao_Paulo) e a criacao/edicao
# da turma mantem as aulas geradas ate LESSONS_HORIZON_DAYS dias a frente (padrao 60; 1 a 365). LESSONS_CRON=false desliga so o job
# (os testes e2e ja rodam com false). Ver docs/EASYPANEL.md, secao 18.
LESSONS_HORIZON_DAYS=60
LESSONS_CRON=true

# Observabilidade minima: REQUEST_LOG=true escreve UMA linha JSON por requisicao no stdout (metodo, rota-padrao,
# status, ms, requestId, userId, ip; nunca corpo/querystring/cabecalhos). O X-Request-Id sai em TODA resposta.
REQUEST_LOG=false

# 2FA (TOTP opt-in): o segredo de cada usuario fica cifrado (AES-256-GCM) com uma chave derivada de TWO_FACTOR_KEY;
# sem ela usa o JWT_SECRET (entao girar o JWT_SECRET invalidaria os segredos ja cifrados: em producao fixe TWO_FACTOR_KEY).
# TWO_FACTOR_MAX_FAILURES = codigos errados tolerados por usuario em 15 min antes do bloqueio 429 (padrao 5);
# TWO_FACTOR_THROTTLE_LIMIT = tentativas/min por IP nas rotas /auth/2fa/* (padrao 10).
TWO_FACTOR_KEY=
TWO_FACTOR_MAX_FAILURES=5
TWO_FACTOR_THROTTLE_LIMIT=10

# Ficha unica do capoeirista (docs/FICHA_UNICA.md): o CPF da ficha (Person) fica cifrado (AES-256-GCM, chave derivada de
# PERSON_DOC_KEY) e a busca "esse CPF ja tem ficha?" usa HMAC-SHA256 com PERSON_DOC_PEPPER. Vazias = derivam do JWT_SECRET.
# NUNCA troque depois de existirem fichas: pepper novo = o CPF nao acha mais a ficha (duplicatas); chave nova = CPF ilegivel.
# PERSON_BACKFILL (so no boot do Docker, ou `npm run person:backfill` manual): vazio = liga as matriculas sem ficha;
# true = sempre; false = nunca.
PERSON_DOC_KEY=
PERSON_DOC_PEPPER=
PERSON_BACKFILL=

# Transferencia entre grupos (ficha unica, Fase 2): TRANSFER_CRON=false desliga o job diario 04:15 (os testes e2e ja rodam
# com false); TRANSFER_EXPIRY_DAYS = prazo para a pessoa decidir (1-90, padrao 14); TRANSFER_CONTEST_DAYS = janela de
# contestacao do grupo antigo a partir do pedido (1-60, padrao 7).
TRANSFER_CRON=true
TRANSFER_EXPIRY_DAYS=14
TRANSFER_CONTEST_DAYS=7

# Cargos acumulaveis (ficha unica, Fase 3): ROLES_BACKFILL (so no boot do Docker, ou `npm run roles:backfill` manual):
# vazio = cria cargo + matricula de aluno (isStaff) da equipe que ainda nao tem; true = sempre; false = nunca.
ROLES_BACKFILL=

# Cargos DO GRUPO (ficha unica, secao 13): GROUP_ROLES_BACKFILL (so no boot do Docker, ou `npm run group-roles:backfill` manual):
# vazio = cria os 4 cargos padrao dos grupos sem eles e liga cargos antigos ao padrao; true = sempre; false = nunca.
GROUP_ROLES_BACKFILL=

# Pix de mensalidade na conta Mercado Pago DE CADA GRUPO (PLANO_PROJETO.md 10.52/10.55; passo a passo em docs/EASYPANEL.md,
# secao 25). O AMBIENTE NAO PRECISA DE NENHUMA VARIAVEL DO MERCADO PAGO: cada Mestre cola as credenciais da PROPRIA conta
# na tela de configuracao do painel (Financeiro). Tudo abaixo e OPCIONAL.
# PAYMENTS_PROVIDER: mercadopago | stub (simulado, sem rede; padrao fora de producao; PROIBIDO em producao - derruba o boot).
# PAYMENTS_TOKEN_KEY (RECOMENDADA, nao obrigatoria): chave-mestra das credenciais cifradas dos grupos (ex.: openssl rand -hex
# 32). Vazia = deriva do JWT_SECRET. Retrocompativel (10.56): definida DEPOIS, as contas antigas ainda decifram pela chave
# derivada do JWT_SECRET e sao re-cifradas com a nova no primeiro uso. Rotacao: a antiga em PAYMENTS_TOKEN_KEY_PREVIOUS.
# SEM ela, trocar o JWT_SECRET torna as credenciais ilegiveis - a conta vira ERROR (1 aviso) e o Mestre cola o token de novo.
# PAINEL_URL (ja existente, acima): monta a URL do webhook de cada grupo (<PAINEL_URL>/api/webhooks/mercadopago?org=<id>),
# enviada em cada Pix como notification_url (so https). Sem ela a baixa vem da consulta do Pix e da reconciliacao.
# PAYMENTS_ALLOW_TEST_ACCOUNTS=true: aceita credencial/pagamento de TESTE do MP em producao (so homologacao).
# PAYMENTS_FALLBACK_PAYER_EMAIL: pagador tecnico quando aluno/responsavel nao tem e-mail.
# PAYMENTS_RECONCILE_CRON=false desliga a reconciliacao (a cada 15 min).
# --- So para o OAuth (OPCIONAL/avancado; dormente sem as 3): MERCADOPAGO_CLIENT_ID/SECRET/REDIRECT_URI (aplicacao do GingApp
# no MP; REDIRECT_URI = https://<dominio>/api/payments/mercadopago/callback). PAYMENTS_APPLICATION_FEE_PERCENT (0-50, padrao
# 0) so vale no OAuth: no modo manual NAO ha split nem taxa da plataforma.
# MERCADOPAGO_WEBHOOK_SECRET (compatibilidade): assinatura global do webhook, usada SO para contas OAUTH (nunca no manual).
# Limites do webhook (por processo): WEBHOOK_UNSIGNED_KNOWN_ORG_LIMIT (120), WEBHOOK_UNSIGNED_ORG_LIMIT (10),
# WEBHOOK_UNSIGNED_COOLDOWN_MS (5000) - ver docs/EASYPANEL.md 25.1.
PAYMENTS_PROVIDER=stub
PAYMENTS_TOKEN_KEY=
PAYMENTS_TOKEN_KEY_PREVIOUS=
PAYMENTS_ALLOW_TEST_ACCOUNTS=false
PAYMENTS_FALLBACK_PAYER_EMAIL=
PAYMENTS_RECONCILE_CRON=true
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENTS_APPLICATION_FEE_PERCENT=0
