# PostgreSQL (Prisma)
# Via docker-compose (dev): o backend roda dentro do compose, use o hostname do serviço.
#   DATABASE_URL="postgresql://gingapp:gingapp@postgres:5432/gingapp?schema=public"
# Rodando o backend nativamente (fora do Docker) contra o Postgres do docker-compose
# (exposto em 15432 — esta máquina já tem outros Postgres em 5432/5433/55432 de outros projetos):
DATABASE_URL="postgresql://gingapp:gingapp@localhost:15432/gingapp?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Allowlist de IP para POST /api/auth/platform-login (opcional).
# Lista separada por virgula. Se vazio/ausente, nenhuma restricao de IP e aplicada.
PLATFORM_ALLOWED_IPS=

# Porta HTTP do backend
PORT=3000

# Job diario de mensalidade vencida (03:00 America/Sao_Paulo). OVERDUE_CRON=false desliga (os testes e2e ja rodam com false).
OVERDUE_CRON=true
# true = o servidor tambem barra (403 TERMS_NOT_ACCEPTED) quem nao aceitou a versao vigente dos Termos/Politica.
# Padrao false: so o frontend exige o aceite (seed/demo/e2e continuam funcionando).
TERMS_ENFORCEMENT=false

# Imagens enviadas por POST /uploads (foto de aluno, logo, capas): gravadas em disco, sem servico externo.
# Padrao ./uploads (fica fora do git). Em Docker/Easypanel: /app/uploads (volume gingapp_uploads).
UPLOADS_DIR=./uploads
# Cota de imagens por grupo em MB (padrao 1024; 0 = sem limite) e envios por minuto por usuario/IP (padrao 20).
UPLOAD_ORG_QUOTA_MB=1024
UPLOAD_THROTTLE_LIMIT=20

# E-mail transacional OPCIONAL (E05): "Esqueci minha senha" + convite por e-mail. Sem SMTP_HOST fica desligado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Web Push OPCIONAL (I13): avisos no celular. Sem as 3 variaveis fica desligado. Gere com `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Firebase Cloud Messaging (FCM) OPCIONAL: transporte principal dos avisos push (app aberto e fechado). Precisa das DUAS
# metades (conta de servico + app Web); faltando qualquer uma fica desligado e o Web Push VAPID acima assume.
# Passo a passo no console Firebase: docs/EASYPANEL.md, secao 13b. A chave privada e' segredo (nunca commite).
# Conta de servico: FIREBASE_PRIVATE_KEY aceita \n escapado; FIREBASE_SERVICE_ACCOUNT_JSON (json em base64) substitui os 3.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Config do SDK web (servida ao app em runtime por GET /api/push/config; nada em VITE_*):
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
# Mapa da comunidade OPCIONAL (Google Maps). Sem GOOGLE_MAPS_API_KEY o app mostra lista no lugar do mapa.
# API_KEY = chave de NAVEGADOR (referrer); SERVER_KEY = chave de SERVIDOR so para geocodificar enderecos (nunca vai ao
# navegador; vazia = nao geocodifica); MAP_ID = ID de mapa estilizado (opcional). Ver docs/EASYPANEL.md, secao 14.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
# Origens dos frontends para os links dos e-mails e o QR do certificado PDF.
APP_URL=http://localhost:4173
PAINEL_URL=http://localhost:4174
ADMIN_URL=http://localhost:4175

# Manutencao semanal (domingo de madrugada, America/Sao_Paulo; os testes e2e rodam com tudo desligado):
# AUDIT_RETENTION_DAYS = dias de retencao da trilha de auditoria (padrao 365; 0 = nunca apagar);
# AUDIT_RETENTION_CRON=false desliga o job. UPLOADS_GC=false desliga a limpeza de imagens orfas
# (enviadas e nao usadas por nenhum campo ha mais de 24 h); UPLOADS_GC=dry-run so registra no log o que apagaria.
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON=true
UPLOADS_GC=true

# Ginga Rank (ranking de alunos e grupos): RANKING_CRON=false desliga o recalculo noturno (02:30) e o fechamento mensal da
# temporada (dia 1, 03:00; America/Sao_Paulo) - os testes e2e ja rodam com false. RANKING_BACKFILL (so no boot do Docker, ou
# `npm run ranking:backfill` manual): vazio = deriva os pontos do historico UMA vez (tabela vazia); true = sempre; false = nunca.
RANKING_CRON=true
RANKING_BACKFILL=

# Aulas continuas (turma com horario fixo semanal nao precisa de data final): o job diario (01:30, America/Sao_Paulo) e a criacao/edicao
# da turma mantem as aulas geradas ate LESSONS_HORIZON_DAYS dias a frente (padrao 60; 1 a 365). LESSONS_CRON=false desliga so o job
# (os testes e2e ja rodam com false). Ver docs/EASYPANEL.md, secao 18.
LESSONS_HORIZON_DAYS=60
LESSONS_CRON=true

# Observabilidade minima: REQUEST_LOG=true escreve UMA linha JSON por requisicao no stdout (metodo, rota-padrao,
# status, ms, requestId, userId, ip; nunca corpo/querystring/cabecalhos). O X-Request-Id sai em TODA resposta.
REQUEST_LOG=false

# 2FA (TOTP opt-in): o segredo de cada usuario fica cifrado (AES-256-GCM) com uma chave derivada de TWO_FACTOR_KEY;
# sem ela usa o JWT_SECRET (entao girar o JWT_SECRET invalidaria os segredos ja cifrados: em producao fixe TWO_FACTOR_KEY).
# TWO_FACTOR_MAX_FAILURES = codigos errados tolerados por usuario em 15 min antes do bloqueio 429 (padrao 5);
# TWO_FACTOR_THROTTLE_LIMIT = tentativas/min por IP nas rotas /auth/2fa/* (padrao 10).
TWO_FACTOR_KEY=
TWO_FACTOR_MAX_FAILURES=5
TWO_FACTOR_THROTTLE_LIMIT=10

# Ficha unica do capoeirista (docs/FICHA_UNICA.md): o CPF da ficha (Person) fica cifrado (AES-256-GCM, chave derivada de
# PERSON_DOC_KEY) e a busca "esse CPF ja tem ficha?" usa HMAC-SHA256 com PERSON_DOC_PEPPER. Vazias = derivam do JWT_SECRET.
# NUNCA troque depois de existirem fichas: pepper novo = o CPF nao acha mais a ficha (duplicatas); chave nova = CPF ilegivel.
# PERSON_BACKFILL (so no boot do Docker, ou `npm run person:backfill` manual): vazio = liga as matriculas sem ficha;
# true = sempre; false = nunca.
PERSON_DOC_KEY=
PERSON_DOC_PEPPER=
PERSON_BACKFILL=
