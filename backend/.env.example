# PostgreSQL (Prisma)
# Via docker-compose (dev): o backend roda dentro do compose, use o hostname do serviço.
#   DATABASE_URL="postgresql://gingapp:gingapp@postgres:5432/gingapp?schema=public"
# Rodando o backend nativamente (fora do Docker) contra o Postgres do docker-compose
# (exposto em 15432 — esta máquina já tem outros Postgres em 5432/5433/55432 de outros projetos):
DATABASE_URL="postgresql://gingapp:gingapp@localhost:15432/gingapp?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Allowlist de IP para POST /api/auth/platform-login (opcional).
# Lista separada por virgula. Se vazio/ausente, nenhuma restricao de IP e aplicada.
PLATFORM_ALLOWED_IPS=

# Porta HTTP do backend
PORT=3000

# Job diario de mensalidade vencida (03:00 America/Sao_Paulo). OVERDUE_CRON=false desliga (os testes e2e ja rodam com false).
OVERDUE_CRON=true
# true = o servidor tambem barra (403 TERMS_NOT_ACCEPTED) quem nao aceitou a versao vigente dos Termos/Politica.
# Padrao false: so o frontend exige o aceite (seed/demo/e2e continuam funcionando).
TERMS_ENFORCEMENT=false

# Imagens enviadas por POST /uploads (foto de aluno, logo, capas): gravadas em disco, sem servico externo.
# Padrao ./uploads (fica fora do git). Em Docker/Easypanel: /app/uploads (volume gingapp_uploads).
UPLOADS_DIR=./uploads
# Cota de imagens por grupo em MB (padrao 1024; 0 = sem limite) e envios por minuto por usuario/IP (padrao 20).
UPLOAD_ORG_QUOTA_MB=1024
UPLOAD_THROTTLE_LIMIT=20

# E-mail transacional OPCIONAL (E05): "Esqueci minha senha" + convite por e-mail. Sem SMTP_HOST fica desligado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Origens dos frontends para os links dos e-mails e o QR do certificado PDF.
APP_URL=http://localhost:4173
PAINEL_URL=http://localhost:4174
ADMIN_URL=http://localhost:4175
