{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "../assets/fonts/*.woff", "outDir": "dist/assets" },
      { "include": "../assets/fonts/*.txt", "outDir": "dist/assets" }
    ]
  }
}
