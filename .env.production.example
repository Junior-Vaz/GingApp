# Copie para .env.production e preencha com valores reais antes de rodar
# docker-compose.prod.yml. Nunca commitar o .env.production de verdade (já está no .gitignore).

# Senha do Postgres de produção — gere algo forte (ex.: openssl rand -base64 32).
POSTGRES_PASSWORD=

# Segredo de assinatura dos JWT — string longa e aleatória (ex.: openssl rand -base64 48).
# Trocar isso invalida todos os tokens emitidos até então (força logout de todo mundo).
JWT_SECRET=

# Origens (domínios dos frontends) autorizadas a chamar a API, separadas por vírgula, sem barra
# final. OBRIGATÓRIO: o backend recusa subir em produção sem isto. Nunca use "*".
CORS_ORIGINS=

# Quantos proxies reversos estão na frente do backend (ex.: 1 para um nginx/Caddy). Deixe vazio
# se NÃO houver proxy. Com proxy, defina-o: senão o backend vê o IP do proxy e a allowlist abaixo
# e o limite de tentativas de login passam a valer para todos juntos.
TRUST_PROXY=

# O JWT_SECRET acima precisa ter pelo menos 32 caracteres e não pode ser "dev-secret-change-me":
# o backend recusa subir em produção caso contrário.

# Allowlist de IP para POST /api/auth/platform-login (opcional). Lista separada por vírgula.
# Deixe vazio para não restringir por IP.
PLATFORM_ALLOWED_IPS=

# URL pública da API que os 3 frontends vão embutir NO BUILD (Vite não lê isso em runtime —
# trocar este valor exige rebuildar as imagens dos frontends, não só reiniciar o container).
# Em dev/local, o padrão http://localhost:3000/api já funciona.
VITE_API_URL=http://localhost:3000/api

# URL pública do app do aluno, embutida NO BUILD do painel: o QR dos certificados abre
# /verificar/:code nele (o painel não tem essa página). Ex.: https://app.gingapp.com.br
VITE_APP_URL=http://localhost:8082
