# dependencies
node_modules/

# build output
dist/
dist-ssr/
build/

# env files (never commit secrets)
.env
.env.local
.env.*.local
.env.production
.env.*.production
!.env.production.example
# Easypanel: .env.easypanel (real, com segredos) e variantes ficam fora do git; so o .example entra
.env.easypanel
.env.easypanel.*
!.env.easypanel.example

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# TypeScript build cache
*.tsbuildinfo

# Prisma
backend/prisma/migrations/**/migration_lock.toml.bak

# Claude Code local session state (per-machine, not shared)
.claude/
