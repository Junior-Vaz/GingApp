# ============================================================================
#  GingApp - variaveis do deploy no EASYPANEL (docker-compose.easypanel.yml)
# ============================================================================
# Copie para .env.easypanel e preencha (ou cole os pares CHAVE=VALOR direto no painel do
# Easypanel: servico Compose > Environment). O .env.easypanel REAL contem segredos e NUNCA
# deve ser commitado: ele esta no .gitignore; so este arquivo .example vai para o git.
#
# Testar a sintaxe do compose com os seus valores:
#   docker compose -f docker-compose.easypanel.yml --env-file .env.easypanel config
#
# Dica: nos valores abaixo evite aspas e o caractere "$" (o compose interpreta "$"). Segredos
# gerados com `openssl rand -hex 32` so tem 0-9 e a-f e nao dao problema.

# --- 1. BANCO DE DADOS [OBRIGATORIA] ---------------------------------------
# O Postgres 16 SOBE DENTRO deste compose (servico "postgres", dados no volume gingapp_pgdata).
# A DATABASE_URL do backend/migrate e montada sozinha a partir da senha abaixo:
#   postgresql://gingapp:<POSTGRES_PASSWORD>@postgres:5432/gingapp?schema=public
# Use uma senha SO COM LETRAS E NUMEROS (ela entra dentro de uma URL; @ : / ? # ! % quebrariam a
# URL). Gere com:  openssl rand -hex 24
# ATENCAO: a senha so vale na PRIMEIRA criacao do volume. Trocar esta variavel depois NAO troca a
# senha ja gravada no banco (o backend passaria a falhar com autenticacao). Para trocar de verdade:
# ALTER USER gingapp PASSWORD '...' dentro do Postgres e depois atualize esta variavel.
POSTGRES_PASSWORD=

# [OPCIONAL] Banco EXTERNO: so preencha se NAO quiser usar o Postgres do compose (nesse caso o
# servico "postgres" sobe sem uso). Formato completo, com o sufixo ?schema=public. Vazio = usa o
# Postgres do compose.
DATABASE_URL=

# --- 2. SEGURANCA [OBRIGATORIAS - o backend NAO sobe sem] -------------------
# Segredo que assina os tokens de login (JWT). Regra: no minimo 32 caracteres aleatorios e
# diferente do valor de desenvolvimento ("dev-secret-change-me"); em producao o backend
# recusa subir com qualquer outro. Gere com:
#   openssl rand -hex 32
# Trocar depois invalida todos os logins ativos (todo mundo precisa entrar de novo).
JWT_SECRET=

# Validade do token de login (formato do JWT: 1d, 12h, 30m...). Opcional; padrao 1d.
JWT_EXPIRES_IN=1d

# Origens (dominios) dos 3 frontends autorizados a chamar a API, separadas por virgula.
# Regras: https, origem EXATA (esquema + dominio), SEM barra final, sem "*" (o backend recusa
# "*" em producao). Se faltar um dominio, o navegador bloqueia as chamadas dele (erro de CORS
# no console). Exemplo:
#   CORS_ORIGINS=https://painel.seudominio.com.br,https://app.seudominio.com.br,https://admin.seudominio.com.br
CORS_ORIGINS=

# Quantos proxies reversos existem na frente do backend. No Easypanel (proxy dele na frente)
# use 1. Sem isto o backend enxerga o IP do proxy e a restricao por IP e o limite de tentativas
# de login passam a valer para todos juntos.
TRUST_PROXY=1

# Restricao por IP do login do admin da plataforma (POST /api/auth/platform-login).
# OPCIONAL. Lista de IPs separados por virgula, comparacao EXATA (o codigo nao aceita CIDR/faixa).
# Vazio = sem restricao. Antes de preencher leia a secao de riscos em docs/EASYPANEL.md
# (se o seu IP mudar, voce se tranca para fora do admin). Exemplo: 203.0.113.7,198.51.100.4
PLATFORM_ALLOWED_IPS=

# --- 3. SUPER ADMIN INICIAL [preencha no 1o deploy] --------------------------
# Lidas pelo servico "migrate" (backend/prisma/bootstrap.ts, idempotente): cria o super admin
# da plataforma (login no admin) se o e-mail ainda nao existir; se ja existir, NAO muda nada
# (nem a senha). Use um e-mail real seu.
# EMAIL e PASSWORD devem ser definidos JUNTOS: so um dos dois, ou senha invalida, FAZ O MIGRATE
# FALHAR (e o backend nao sobe). Sem nenhum dos dois: so aplica as permissoes base e avisa -
# voce ficaria SEM admin.
# SENHA (regras do bootstrap): 12 a 72 bytes, pelo menos 3 das 4 classes (minuscula, maiuscula,
# digito, simbolo), 6+ caracteres distintos, sem espaco nas pontas, sem conter o e-mail e sem
# termos triviais (dev@12345, password, senha, 123456, qwerty, gingapp, admin, changeme,
# letmein). NUNCA "Dev@12345" (senha dos dados de desenvolvimento, publica no repositorio).
# Sugestao: openssl rand -base64 18  (ou um gerenciador de senhas; evite o caractere "$").
# Troque a senha depois do 1o login pelo admin (ver docs/EASYPANEL.md).
# NAME e opcional (2 a 120 caracteres; padrao do bootstrap: "Super Admin").
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Imagem do Postgres [OPCIONAL]. Padrao postgres:16-alpine (Docker Hub). Se o servidor tomar
# "toomanyrequests" (limite de pulls sem login) ou timeout no Docker Hub, use o espelho da AWS:
#   POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
POSTGRES_IMAGE=

# Registro das imagens [OPCIONAL]. Padrao ghcr.io/junior-vaz (GHCR). Se o servidor NAO alcanca o
# ghcr.io (TLS handshake timeout) mas alcanca o Docker Hub, use as imagens publicadas no Docker Hub:
#   IMAGE_PREFIX=docker.io/SEU_USUARIO_DO_DOCKERHUB   (em minusculas)
# Requer os secrets DOCKERHUB_USERNAME e DOCKERHUB_TOKEN no GitHub (ver docs/EASYPANEL.md, secao 15).
IMAGE_PREFIX=

# Politica de pull das imagens do GHCR [OPCIONAL]. Padrao "always": todo deploy baixa a imagem nova
# (atualiza o "latest"). Se o servidor nao consegue falar com o ghcr.io (TLS handshake timeout), baixe
# as 5 imagens a mao com `docker pull` (ver docs/EASYPANEL.md, secao 13) e use PULL_POLICY=missing
# para o deploy usar as imagens ja baixadas, sem contatar o registro. Volte para "always" (ou apague
# a linha) quando a rede estiver boa, senao os deploys nao pegam versoes novas.
PULL_POLICY=

# --- 4. VERSAO DAS IMAGENS [OPCIONAL] ---------------------------------------
# "latest" = ultima publicada pelo CI (padrao). Para fixar/voltar uma versao, use o SHA do
# commit publicado no GHCR (o mesmo SHA vale para as 5 imagens). Exemplo: IMAGE_TAG=82e33e7...
# (o tag e o SHA COMPLETO de 40 caracteres do commit, nao o abreviado).
IMAGE_TAG=latest

# ============================================================================
#  SO PARA docker-compose.easypanel-build.yml (build das imagens no servidor, sem GHCR)
# ============================================================================
# Nesse compose os frontends sao buildados no proprio Easypanel, entao as URLs sao variaveis DESTE
# ambiente (obrigatorias nele; ignoradas no docker-compose.easypanel.yml). Mudou o dominio? Altere e
# faca novo Deploy (rebuilda os frontends).
#   VITE_API_URL = https://api.seudominio.com.br/api   (inclui /api, sem barra final)
#   VITE_APP_URL = https://app.seudominio.com.br
VITE_API_URL=
VITE_APP_URL=
# Imagens base [OPCIONAL] - so se o Docker Hub der toomanyrequests/timeout no servidor (espelho AWS):
#   NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
#   NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.27-alpine
NODE_IMAGE=
NGINX_IMAGE=

# ============================================================================
#  NAO ficam aqui (compose do GHCR): VITE_API_URL e VITE_APP_URL
# ============================================================================
# Os 3 frontends sao arquivos estaticos (nginx): o Vite EMBUTE VITE_API_URL (todos) e
# VITE_APP_URL (so o painel) NO BUNDLE na hora do build da imagem, que acontece no GitHub
# Actions - nao no Easypanel. Configure-as como SECRETS do repositorio no GitHub:
#   VITE_API_URL = https://api.seudominio.com.br/api     (inclui o prefixo /api, sem barra final)
#   VITE_APP_URL = https://app.seudominio.com.br         (origem do app do aluno; usada nos QR de certificados)
# Mudou o dominio? Atualize os secrets, rode o workflow "Build & Push Docker Images" de novo
# e faca redeploy dos 3 frontends. Definir VITE_* no Easypanel NAO tem efeito.
