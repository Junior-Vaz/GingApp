# GingApp - variaveis do Easypanel (UNICO arquivo de variaveis; compose: docker-compose.easypanel.yml)
# Copie os pares CHAVE=VALOR para o Environment do servico Compose no Easypanel. Evite aspas e o
# caractere "$" nos valores. NUNCA commite o arquivo preenchido.

# Senha do banco (SO letras e numeros: ela entra dentro de uma URL). Gere: openssl rand -hex 24
# So vale na PRIMEIRA criacao do volume do banco; trocar depois nao muda a senha ja gravada.
POSTGRES_PASSWORD=

# Segredo dos tokens de login: 32+ caracteres aleatorios. Gere: openssl rand -hex 32
JWT_SECRET=

# Super admin inicial (login no admin). EMAIL e PASSWORD juntos. Senha: 12+ caracteres, 3 de 4 classes
# (minuscula, maiuscula, digito, simbolo), sem conter o e-mail nem termos como dev@12345/senha/admin/gingapp.
# Troque a senha pelo proprio admin depois do 1o login (Equipe > Redefinir senha).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# [OPCIONAL] Grupo de demonstracao ("Grupo Axe Demo", slug demo) com dados ficticios completos
# (alunos, turmas, financeiro, eventos...). Para ligar: DEMO_GROUP=true e DEMO_PASSWORD (a senha de TODAS as
# contas demo: mestre@, professor1@..professor3@, aluno1@..aluno4@demo.gingapp.com.br). Mesma politica de
# senha do super admin: 12+ caracteres, 3 de 4 classes, sem "senha"/"admin"/"gingapp"/"dev@12345".
# Sem a senha (ou fraca) o demo NAO e criado e a API sobe normalmente; veja o log do backend.
# Para desligar: apague as duas (ou DEMO_GROUP=false). Desligar NAO apaga os dados ja criados.
DEMO_GROUP=
DEMO_PASSWORD=

# [OPCIONAL] Backup diario do banco (servico "backup": pg_dump -Fc para o volume gingapp_backups).
# BACKUP_ENABLED=false desliga; BACKUP_KEEP_DAYS = quantos dias de dumps guardar (padrao 14);
# BACKUP_INTERVAL_HOURS = intervalo entre dumps (padrao 24). Restore passo a passo: docs/EASYPANEL.md secao 7.
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=14

# [OPCIONAL] OVERDUE_CRON=false desliga o job diario (03:00 America/Sao_Paulo) que marca mensalidades vencidas.
# TERMS_ENFORCEMENT=true faz o servidor barrar (403) quem nao aceitou a versao vigente dos Termos/Politica
# (padrao false: so o frontend exige o aceite).
OVERDUE_CRON=true
TERMS_ENFORCEMENT=false

# [OPCIONAL] Manutencao semanal: AUDIT_RETENTION_DAYS = retencao da auditoria em dias (0 = nunca apagar);
# UPLOADS_GC=false desliga a limpeza de imagens orfas (dry-run = so log). REQUEST_LOG=true liga o log JSON por requisicao.
# TWO_FACTOR_KEY = chave que cifra os segredos do 2FA (gere uma aleatoria e NAO a perca; vazia = usa o JWT_SECRET).
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_CRON=true
UPLOADS_GC=true

# [OPCIONAL] Ginga Rank (ranking de alunos e grupos). RANKING_CRON=false desliga o recalculo noturno (02:30) e o fechamento
# mensal da temporada (dia 1, 03:00; America/Sao_Paulo). RANKING_BACKFILL: vazio = deriva os pontos do historico UMA vez no
# primeiro boot (tabela de pontos vazia); true = a cada boot; false = nunca. Ver docs/EASYPANEL.md, secao 17.
RANKING_CRON=true
RANKING_BACKFILL=

# [OPCIONAL] Aulas continuas (sem data final): o job diario (01:30, America/Sao_Paulo) e a criacao/edicao da turma mantem as aulas
# geradas ate LESSONS_HORIZON_DAYS dias a frente (padrao 60; 1 a 365). LESSONS_CRON=false desliga so o job. Ver docs/EASYPANEL.md, secao 18.
LESSONS_HORIZON_DAYS=60
LESSONS_CRON=true
REQUEST_LOG=false
TWO_FACTOR_KEY=

# [RECOMENDADO] Ficha unica do capoeirista (docs/FICHA_UNICA.md e docs/EASYPANEL.md secao 25). PERSON_DOC_KEY cifra o CPF
# guardado na ficha; PERSON_DOC_PEPPER e o segredo do hash de busca por CPF. Gere valores aleatorios longos ANTES do primeiro
# boot com a ficha unica e NUNCA os troque (vazias = derivam do JWT_SECRET, que entao tambem nao pode mais ser trocado).
# PERSON_BACKFILL: vazio = no boot liga as matriculas sem ficha (idempotente); true = sempre; false = nunca.
PERSON_DOC_KEY=
PERSON_DOC_PEPPER=
PERSON_BACKFILL=

# [OPCIONAL] Transferencia entre grupos (Fase 2 da ficha unica): TRANSFER_CRON=false desliga o job diario (04:15) que expira
# pedidos sem resposta e encerra a janela de contestacao. Prazos em dias: decisao da pessoa (padrao 14) e contestacao do
# grupo antigo, contada do pedido (padrao 7). Ver docs/EASYPANEL.md secao 20.
TRANSFER_CRON=true
TRANSFER_EXPIRY_DAYS=14
TRANSFER_CONTEST_DAYS=7

# [OPCIONAL] Cargos acumulaveis (Fase 3): ROLES_BACKFILL vazio = no boot, cria o cargo e a matricula de aluno (isStaff, fora do
# limite do plano e sem mensalidade) de quem e da equipe e ainda nao tem; true = sempre; false = nunca. Ver docs/EASYPANEL.md secao 21.
ROLES_BACKFILL=

# [OPCIONAL] Cargos DO GRUPO (ficha unica, secao 13): GROUP_ROLES_BACKFILL vazio = no boot, cria os 4 cargos padrao
# (Mestre/Professor/Instrutor/Monitor) dos grupos que ainda nao tem e liga cargos antigos ao padrao (nunca muda acesso);
# true = sempre; false = nunca. Ver docs/EASYPANEL.md secao 23.
GROUP_ROLES_BACKFILL=

# [OPCIONAL] E-mail transacional por SMTP: liga o "Esqueci minha senha" (app, painel e admin) e o convite por e-mail de
# aluno/responsavel. Sem SMTP_HOST (e remetente) tudo fica DESLIGADO e o sistema funciona como antes. SMTP_PORT padrao 587
# (STARTTLS); SMTP_SECURE=true usa TLS direto (porta 465). SMTP_FROM ex.: GingApp <nao-responder@seudominio.com.br>
# (se vazio, usa SMTP_USER quando for um e-mail). Nunca commite a senha SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=

# [OPCIONAL] Web Push: avisos no celular (app PWA do aluno/responsavel). Sem as 3 variaveis tudo fica DESLIGADO e o sistema
# funciona como antes. Gere o par de chaves UMA vez: `npx web-push generate-vapid-keys` (Public Key -> VAPID_PUBLIC_KEY,
# Private Key -> VAPID_PRIVATE_KEY). Trocar as chaves depois invalida as inscricoes ja feitas. VAPID_SUBJECT = mailto:
# do contato tecnico (ou uma URL https). Nunca commite a chave privada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# [OPCIONAL] Firebase Cloud Messaging (FCM): transporte PRINCIPAL dos avisos push (funciona com o app aberto e fechado).
# Precisa das DUAS metades; faltando qualquer campo o FCM fica desligado e o Web Push VAPID acima (se houver) assume.
# Nada disso vai no build do app: a config web e' servida em runtime por GET /api/push/config. Passo a passo no console
# Firebase: docs/EASYPANEL.md, secao 13b. NUNCA commite a chave privada.
# --- (1) Conta de servico (Configuracoes do projeto > Contas de servico > Gerar nova chave privada -> .json) ---
#   FIREBASE_PROJECT_ID    = campo "project_id" do .json
#   FIREBASE_CLIENT_EMAIL  = campo "client_email" do .json
#   FIREBASE_PRIVATE_KEY   = campo "private_key" do .json (cole inteiro; \n escapado ou quebras reais, com ou sem aspas)
#   FIREBASE_SERVICE_ACCOUNT_JSON = ALTERNATIVA aos 3 acima: o .json inteiro em base64 (PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("chave.json")))
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# --- (2) App Web (Configuracoes do projeto > Geral > Seus apps > </> Web > Configuracao do SDK) ---
#   FIREBASE_WEB_API_KEY = apiKey | FIREBASE_WEB_AUTH_DOMAIN = authDomain (vazio = <project_id>.firebaseapp.com)
#   FIREBASE_WEB_STORAGE_BUCKET = storageBucket (opcional) | FIREBASE_WEB_MESSAGING_SENDER_ID = messagingSenderId
#   FIREBASE_WEB_APP_ID = appId
#   FIREBASE_WEB_VAPID_KEY = Cloud Messaging > Configuracao da Web > Certificados push da Web > Gerar par de chaves (chave publica)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# [OPCIONAL] Mapa da comunidade (Google Maps) em app.gingapp.com.br/comunidade. Sem GOOGLE_MAPS_API_KEY o app mostra uma
# lista no lugar do mapa e nada mais muda. Passo a passo no Google Cloud: docs/EASYPANEL.md, secao 14.
#  - GOOGLE_MAPS_API_KEY: chave de NAVEGADOR (Maps JavaScript API), restrita por HTTP referrer a https://app.gingapp.com.br/*
#    (e publica por natureza: o app a recebe em GET /api/map/config).
#  - GOOGLE_MAPS_SERVER_KEY: chave de SERVIDOR (Geocoding API) para o botao "Localizar pelo endereco" e a geocodificacao
#    automatica de unidades/eventos/rodas. Restrita por IP do servidor e so a Geocoding API. NUNCA e enviada ao navegador.
#    Vazia = nao geocodifica (o usuario informa latitude/longitude na mao).
#  - GOOGLE_MAPS_MAP_ID: ID de mapa estilizado (opcional, Google Cloud > Map Management).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
# Origens publicas dos frontends para os links dos e-mails e o QR do certificado (padroes abaixo; sem barra final).
APP_URL=https://app.gingapp.com.br
PAINEL_URL=https://painel.gingapp.com.br
ADMIN_URL=https://admin.gingapp.com.br

# [OPCIONAL] Imagens enviadas pelo painel/app (foto de aluno, logo do grupo, capa de evento/roda): ficam em disco, no volume
# gingapp_uploads (sem S3/R2). UPLOAD_ORG_QUOTA_MB = cota de imagens por grupo em MB (padrao 1024; 0 = sem limite).
# O backup diario tambem copia esse volume (gingapp-uploads-*.tgz). Limite por arquivo: 5 MB; JPEG/PNG/WebP.
UPLOAD_ORG_QUOTA_MB=1024

# [OPCIONAL] Formularios de inscricao publicos (link https://app.gingapp.com.br/i/<slug>): os comprovantes enviados sem
# login ficam no volume PRIVADO gingapp_private_uploads (/app/private-uploads, ja fixo no compose; nunca servido por
# /api/uploads). Limite por anexo FORMS_FILE_MAX_MB (padrao 5, maximo 9). Retencao LGPD (job diario 04:45): FORMS_RETENTION_PURGE =
# dry-run (PADRAO: so registra no log o que faria; o termo padrao PROMETE apagar, entao em producao confira o log e
# mude para true) | true (anonimiza respostas e apaga anexos N meses depois do encerramento; N por formulario, padrao
# 12) | false (desliga). Tetos anti-abuso (padroes no codigo, so mude se precisar): FORMS_PENDING_FILES_PER_IP=10,
# FORMS_PENDING_BYTES_MAX_MB=500, FORMS_SUBMISSIONS_PER_IP_HOUR=5, FORMS_SUBMISSIONS_PER_IP_DAY=20, FORMS_WAITLIST_MAX=200,
# FORMS_MAIL_PER_RECIPIENT_DAILY=3, FORMS_MAIL_FORM_HOURLY_MAX=100. FORMS_PUBLIC_LEGACY=true (transicao: aceita o app
# antigo em cache) -> false depois do deploy do app novo. Detalhes: docs/EASYPANEL.md, secao 26.
FORMS_FILE_MAX_MB=5
FORMS_RETENTION_PURGE=dry-run
FORMS_SUBMISSIONS_PER_IP_HOUR=5
FORMS_SUBMISSIONS_PER_IP_DAY=20
FORMS_PUBLIC_LEGACY=true

# [OPCIONAL] Feed do grupo (rota /feed no app; moderacao em /feed-moderacao no painel). As fotos ficam PRIVADAS em
# FEED_MEDIA_DIR (padrao /app/private-uploads/feed, DENTRO do volume persistente gingapp_private_uploads, ja fixo no
# compose; nunca servidas por /api/uploads) e saem so por URL assinada valida FEED_MEDIA_URL_TTL_HOURS (padrao 6).
# Cotas por usuario/dia: FEED_POSTS_PER_DAY (10) e FEED_COMMENTS_PER_DAY (60). FEED_MEDIA_CLEANUP=false desliga a
# limpeza das fotos pendentes/removidas (padrao true). ATENCAO: o backup automatico NAO copia essas fotos (secao 27 do
# docs/EASYPANEL.md). Detalhes: docs/EASYPANEL.md, secao 27.
FEED_MEDIA_URL_TTL_HOURS=6
FEED_POSTS_PER_DAY=10
FEED_COMMENTS_PER_DAY=60
FEED_MEDIA_CLEANUP=true
# Stories do feed: FEED_STORY_TTL_HOURS = validade em horas (padrao 24; limitado a 1..48) e FEED_STORIES_PER_DAY = cota de
# stories por usuario por dia civil SP (padrao 5). A limpeza (FEED_MEDIA_CLEANUP) apaga a foto 1 h depois de vencer.
FEED_STORY_TTL_HOURS=24
FEED_STORIES_PER_DAY=5

# Aniversariantes e Comunicar (docs/EASYPANEL.md secao 28). BIRTHDAY_CRON=false desliga o resumo diario 07:30 (SP) aos
# gestores e os parabens automaticos. COMM_SCHEDULER=false desliga o envio dos comunicados agendados (verifica a cada
# minuto). Cotas por dia civil (SP): COMM_DAILY_LIMIT_ORG por grupo e COMM_DAILY_LIMIT_AUTHOR por autor.
BIRTHDAY_CRON=true
COMM_SCHEDULER=true
COMM_DAILY_LIMIT_ORG=30
COMM_DAILY_LIMIT_AUTHOR=15

# [OPCIONAL] Pix de mensalidade na conta Mercado Pago DE CADA GRUPO. O AMBIENTE NAO PRECISA DE NENHUMA VARIAVEL DO MERCADO
# PAGO: cada Mestre cola as credenciais da PROPRIA conta do grupo na tela de configuracao do painel (Financeiro) e o dinheiro
# cai direto la (o GingApp nunca toca nele). Passo a passo para o Mestre: docs/EASYPANEL.md, secao 25. NUNCA cole credenciais
# reais em arquivo versionado.
#  - PAYMENTS_PROVIDER: mercadopago (padrao em producao; "stub" e proibido em producao e derruba o boot).
#  - PAYMENTS_TOKEN_KEY (RECOMENDADA, nao obrigatoria): chave-mestra das credenciais cifradas dos grupos (openssl rand -hex 32).
#    Vazia = deriva do JWT_SECRET. Pode ser definida DEPOIS: as contas antigas continuam legiveis e sao re-cifradas no uso.
#    Rotacao: a antiga em PAYMENTS_TOKEN_KEY_PREVIOUS. SEM ela, trocar o JWT_SECRET = contas em ERROR (1 aviso) e os Mestres
#    colam o token de novo (o sistema nao cai).
#  - PAINEL_URL (ja definida acima): monta a URL do webhook de cada grupo, enviada em cada Pix (o Mestre nao precisa
#    cadastrar webhook no Mercado Pago).
#  - PAYMENTS_ALLOW_TEST_ACCOUNTS: true SO em homologacao com credenciais de TESTE do MP; em producao real deixe false
#    (credencial de teste e recusada e pagamento de teste nunca da baixa).
#  - PAYMENTS_FALLBACK_PAYER_EMAIL: e-mail tecnico usado como pagador quando aluno/responsavel nao tem e-mail (vazio = exige).
#  - PAYMENTS_RECONCILE_CRON: false desliga a conferencia dos Pix pendentes a cada 15 min.
#  - OAuth (OPCIONAL/avancado, dormente sem as 3): MERCADOPAGO_CLIENT_ID / MERCADOPAGO_CLIENT_SECRET / MERCADOPAGO_REDIRECT_URI
#    (aplicacao do GingApp no MP; REDIRECT_URI = https://painel.gingapp.com.br/api/payments/mercadopago/callback).
#    PAYMENTS_APPLICATION_FEE_PERCENT (taxa da plataforma, 0 a 50) so vale no OAuth: no modo manual nao ha split/taxa.
#  - MERCADOPAGO_WEBHOOK_SECRET (compatibilidade): assinatura global, usada SO para contas OAuth (nunca no modo manual).
PAYMENTS_PROVIDER=mercadopago
PAYMENTS_TOKEN_KEY=
PAYMENTS_TOKEN_KEY_PREVIOUS=
PAYMENTS_ALLOW_TEST_ACCOUNTS=false
PAYMENTS_FALLBACK_PAYER_EMAIL=
PAYMENTS_RECONCILE_CRON=true
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENTS_APPLICATION_FEE_PERCENT=0

# Usuario do Docker Hub (o mesmo do secret DOCKERHUB_USERNAME no GitHub Actions).
# As imagens precisam estar publicas (ou o servidor logado no Docker Hub).
DOCKERHUB_USERNAME=

# Baixa UMA imagem por vez (em vez de todas ao mesmo tempo).
COMPOSE_PARALLEL_LIMIT=1

# E so isso. NAO existe VITE_API_URL/VITE_APP_URL, nem dominio "api.": cada front chama /api no
# proprio dominio e o nginx dele repassa para o backend; o backend aplica as migrations ao subir.
# [OPCIONAL] CORS_ORIGINS (padrao: https://painel.gingapp.com.br,https://app.gingapp.com.br,https://admin.gingapp.com.br)
# so importa se algo chamar a API de outra origem.
