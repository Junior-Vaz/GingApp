# GingApp - variaveis do Easypanel (UNICO arquivo de variaveis; compose: docker-compose.easypanel.yml)
# Copie os pares CHAVE=VALOR para o Environment do servico Compose no Easypanel. Evite aspas e o
# caractere "$" nos valores. NUNCA commite o arquivo preenchido.

# Senha do banco (SO letras e numeros: ela entra dentro de uma URL). Gere: openssl rand -hex 24
# So vale na PRIMEIRA criacao do volume do banco; trocar depois nao muda a senha ja gravada.
POSTGRES_PASSWORD=

# Segredo dos tokens de login: 32+ caracteres aleatorios. Gere: openssl rand -hex 32
JWT_SECRET=

# Super admin inicial (login no admin). EMAIL e PASSWORD juntos. Senha: 12+ caracteres, 3 de 4 classes
# (minuscula, maiuscula, digito, simbolo), sem conter o e-mail nem termos como dev@12345/senha/admin/gingapp.
# Troque a senha pelo proprio admin depois do 1o login (Equipe > Redefinir senha).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Usuario do Docker Hub (o mesmo do secret DOCKERHUB_USERNAME no GitHub Actions).
# As imagens precisam estar publicas (ou o servidor logado no Docker Hub).
DOCKERHUB_USERNAME=

# Baixa UMA imagem por vez (em vez de todas ao mesmo tempo).
COMPOSE_PARALLEL_LIMIT=1

# E so isso. NAO existe VITE_API_URL/VITE_APP_URL, nem dominio "api.": cada front chama /api no
# proprio dominio e o nginx dele repassa para o backend; o backend aplica as migrations ao subir.
# [OPCIONAL] CORS_ORIGINS (padrao: https://painel.gingapp.com.br,https://app.gingapp.com.br,https://admin.gingapp.com.br)
# so importa se algo chamar a API de outra origem.
